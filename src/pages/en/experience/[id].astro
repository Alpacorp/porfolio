---
import View from '../../../views/Company.astro';
import { getCompanies } from '../../../lib/experience';

export async function getStaticPaths() {
  const companies = await getCompanies('en');
  return companies.map((entry, index) => ({
    params: { id: entry.id },
    props: { entry, next: companies[(index + 1) % companies.length] },
  }));
}
---

<View {...Astro.props} />
