---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { education, experience, skills } from '../data/career';
import { profile } from '../data/profile';
import { getCases } from '../lib/projects';

const cases = await getCases();
---

<Base title="CV" description={`CV de ${profile.fullName}, ${profile.role}.`}>
  <main id="contenido" class="cv" tabindex="-1">
    <div class="toolbar no-print">
      <a class="mono back" href="/"><Icon name="arrow-left" size={16} /> alpacorp.net</a>
      <button class="btn btn--dark" type="button" data-print><Icon name="print" size={16} /> Imprimir / guardar PDF</button>
    </div>

    <header class="header">
      <h1 class="name">{profile.fullName}</h1>
      <p class="role">{profile.role} · {profile.focus}</p>
      <ul class="mono muted contact">
        <li>{profile.location}</li>
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={profile.links.linkedin}>linkedin.com/in/alejandro-palacios88</a></li>
        <li><a href={profile.links.github}>github.com/Alpacorp</a></li>
        <li><a href="/">{profile.site}</a></li>
      </ul>
    </header>

    <section>
      <h2 class="eyebrow">Perfil</h2>
      <p>
        Desarrollador de software con más de 9 años construyendo productos digitales para banca, fintech,
        e-commerce, logística y agencias. React, TypeScript, Next.js, Node.js y Go, integración de APIs, pruebas,
        automatización e IA aplicada al desarrollo. Hablo tres idiomas en un equipo: <span class="hl">negocio, marketing y código</span>.
      </p>
    </section>

    <section>
      <h2 class="eyebrow">Experiencia</h2>
      <ol class="list">
        {
          experience.map((job) => (
            <li class="item">
              <div class="item__head">
                <h3>
                  {job.role} · {job.org}
                </h3>
                <span class="mono muted">{job.dates}</span>
              </div>
              <p>{job.text}</p>
              <p class="mono muted small">{job.tags.join(' · ')}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section>
      <h2 class="eyebrow">Proyectos destacados</h2>
      <ul class="list">
        {
          cases.map((c) => (
            <li class="item">
              <div class="item__head">
                <h3>
                  <a href={`/casos/${c.id}/`}>{c.data.title}</a>
                </h3>
                <span class="mono muted">{c.data.client}</span>
              </div>
              <p>
                {c.data.summary}
                {c.data.metric && (
                  <>
                    {' '}
                    <strong>
                      {c.data.metric.value} {c.data.metric.label}.
                    </strong>
                  </>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="two-col">
      <div>
        <h2 class="eyebrow">Educación</h2>
        <ul class="list">
          {
            education.map((e) => (
              <li class="item">
                <h3>{e.title}</h3>
                <p class="mono muted small">
                  {e.org} · {e.dates}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="eyebrow">Habilidades</h2>
        <dl class="skills">
          {
            skills.map((s) => (
              <div>
                <dt>{s.area}</dt>
                <dd class="muted">{s.items}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  </main>
</Base>

<style>
  .cv {
    max-width: 820px;
    margin: 0 auto;
    padding: 48px var(--gutter) 80px;
    display: flex;
    flex-direction: column;
    gap: 36px;
    font-size: 15px;
    line-height: 1.6;
    outline: none;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 13px;
    text-decoration: none;
    color: var(--muted);
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--ink);
  }

  .name {
    font-size: clamp(32px, 5vw, 44px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .role {
    font-size: 17px;
    font-weight: 500;
  }

  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    font-size: 12px;
    line-height: 1.7;
  }

  .contact li:not(:last-child)::after {
    content: '·';
    margin: 0 8px;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    break-inside: avoid;
  }

  .item__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  .item h3 {
    font-size: 16px;
    font-weight: 600;
  }

  .item__head .mono {
    font-size: 12px;
  }

  .small {
    font-size: 12px;
  }

  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
  }

  .two-col > div {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .skills {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .skills dt {
    font-weight: 600;
    font-size: 14px;
  }

  .skills dd {
    margin: 0;
    font-size: 14px;
  }

  @media print {
    .cv {
      padding: 0;
      max-width: none;
      font-size: 10.5pt;
      gap: 18pt;
    }
    @page {
      margin: 16mm 14mm;
    }
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
