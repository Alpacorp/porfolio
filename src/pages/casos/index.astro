---
import Shell from '../../layouts/Shell.astro';
import Cases from '../../components/sections/Cases.astro';
import { getCases } from '../../lib/projects';

const cases = await getCases();
---

<Shell title="Casos de estudio" description="Casos de estudio de Alejandro Palacios Arévalo: banca, fintech, e-commerce, agencias y producto.">
  <div class="page">
    <header class="header">
      <p class="eyebrow">Casos de estudio</p>
      <h1 class="title">Proyectos contados de principio a fin</h1>
      <p class="muted lead">
        El reto, lo que decidí y lo que cambió. Para ver todos los proyectos, incluidos los que no tienen caso,
        <a href="/archivo/">visita el archivo</a>.
      </p>
    </header>
    <Cases cases={cases} heading="Todos los casos" />
  </div>
</Shell>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .title {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .lead {
    font-size: 17px;
    line-height: 1.55;
    max-width: 640px;
  }
</style>
