---
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import BackLink from '../../components/BackLink.astro';
import Logo from '../../components/Logo.astro';
import { formatYears, getCases, statusLabel } from '../../lib/projects';

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Shell title={d.title} description={d.summary}>
  <article class="case">
    <BackLink href="/casos/" label="Todos los casos" />

    <header class="header logo-host">
      {d.logo && <Logo id={d.logo} scale={1.2} class="header__logo" />}
      <p class="eyebrow">{[d.client, d.sector, formatYears(d)].join(' · ')}</p>
      <h1 class="title">{d.title}</h1>
      <p class="summary">{d.summary}</p>
    </header>

    <dl class="facts">
      {
        d.metric && (
          <div class="fact fact--metric">
            <dt class="mono muted">{d.metric.label}</dt>
            <dd>
              <span class="hl">{d.metric.value}</span>
            </dd>
          </div>
        )
      }
      <div class="fact">
        <dt class="mono muted">Tipo</dt>
        <dd>{d.kind === 'empleo' ? 'Empleo' : 'Freelance'}{d.via && ` · vía ${d.via}`}</dd>
      </div>
      <div class="fact">
        <dt class="mono muted">Stack</dt>
        <dd>
          <ul class="stack">{d.stack.map((s) => <li class="tag">{s}</li>)}</ul>
        </dd>
      </div>
      <div class="fact">
        <dt class="mono muted">Estado</dt>
        <dd>
          {
            d.url && d.status === 'live' ? (
              <a href={d.url} rel="noopener" target="_blank">
                Ver en línea <Icon name="arrow-up-right" size={14} />
                <span class="sr-only">(abre en otra pestaña)</span>
              </a>
            ) : (
              statusLabel[d.status]
            )
          }
        </dd>
      </div>
    </dl>

    <div class="prose">
      <Content />
    </div>

    {
      d.links && (
        <section class="links" aria-labelledby="links-titulo">
          <h2 id="links-titulo" class="eyebrow">Versiones en línea</h2>
          <ul>
            {d.links.map((l) => (
              <li class="logo-host">
                {l.logo && <Logo id={l.logo} scale={0.8} />}
                <a href={l.url} rel="noopener" target="_blank">
                  {l.name} <span aria-hidden="true">↗</span>
                  <span class="sr-only">(abre en otra pestaña)</span>
                </a>
                {l.note && <span class="mono muted">{l.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="next card card--interactive" aria-label="Siguiente caso">
      <a href={`/casos/${next.id}/`}>
        <span class="eyebrow">Siguiente caso</span>
        <span class="next__title">{next.data.title} →</span>
      </a>
    </nav>
  </article>
</Shell>

<style>
  .case {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 760px;
  }


  .header {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .header :global(.header__logo) {
    align-self: flex-start;
  }

  .title {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .summary {
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
  }

  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
    gap: 20px 24px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .fact--metric {
    grid-column: 1 / -1;
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }

  .fact dt {
    font-size: 12px;
    line-height: 1.5;
  }

  .fact dd {
    margin: 0;
    font-size: 15px;
  }

  .fact--metric dd {
    font-size: clamp(34px, 5vw, 44px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .prose {
    font-size: 17px;
    line-height: 1.7;
  }

  .prose :global(h2) {
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 40px 0 12px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 16px;
  }

  .prose :global(ul) {
    padding-left: 20px;
  }

  .prose :global(li) {
    margin-bottom: 8px;
  }

  .prose :global(li::marker) {
    color: var(--muted);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .links ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .links li {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .links .muted {
    font-size: 12px;
  }

  .next a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    text-decoration: none;
    color: var(--ink);
  }

  .next__title {
    font-size: 20px;
    font-weight: 600;
  }

  .next:hover .next__title {
    color: var(--mag);
  }
</style>
