---
import View from '../../views/Case.astro';
import { getCases } from '../../lib/projects';
import { caseSlug } from '../../i18n';

export async function getStaticPaths() {
  const cases = await getCases('es');
  return cases.map((entry, i) => ({
    params: { id: caseSlug(entry.id, 'es') },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}
---

<View {...Astro.props} />
