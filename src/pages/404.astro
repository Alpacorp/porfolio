---
import Shell from '../layouts/Shell.astro';
---

<Shell title="Página no encontrada">
  <section class="nf">
    <p class="eyebrow">Error 404</p>
    <h1 class="title">Esta página <span class="hl">no existe</span>.</h1>
    <p class="muted">Puede que el enlace esté viejo. Prueba con ⌘K o vuelve al inicio.</p>
    <p><a href="/">Volver al inicio →</a></p>
  </section>
</Shell>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .title {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.035em;
  }
</style>
