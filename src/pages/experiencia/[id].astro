---
import { getEntries } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import { companyHref, getCompanies } from '../../lib/experience';
import { formatYears, projectHref, statusLabel } from '../../lib/projects';

export async function getStaticPaths() {
  const companies = await getCompanies();
  return companies.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, next: companies[(i + 1) % companies.length] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;

// Resolve each phase's project references once, keeping their order.
const phases = await Promise.all(
  d.phases.map(async (phase) => ({ ...phase, projects: await getEntries(phase.projects) })),
);
---

<Shell title={`${d.role} · ${d.company}`} description={d.summary}>
  <article class="company">
    <a class="back mono" href="/#experiencia"><Icon name="arrow-left" size={16} /> Toda la experiencia</a>

    <header class="header logo-host">
      <Logo id={d.logo} scale={1.3} class="header__logo" />
      <p class="eyebrow">
        {d.company} · {d.start} — {d.end} · {d.location}
      </p>
      <h1 class="title">
        {d.role}{' '}
        {d.current && <span class="now mono">Actual</span>}
      </h1>
      <p class="summary">{d.summary}</p>
    </header>

    <ul class="highlights">
      {d.highlights.map((h) => <li>{h}</li>)}
    </ul>

    <section class="phases" aria-labelledby="etapas-titulo">
      <h2 id="etapas-titulo" class="eyebrow">Etapas</h2>
      <ol class="phase-list">
        {
          phases.map((phase) => (
            <li class="phase" id={phase.id}>
              <p class="phase__period mono">{phase.period}</p>
              <div class="phase__body">
                <h3 class="phase__title">{phase.title}</h3>
                {phase.role && <p class="mono muted phase__role">{phase.role}</p>}
                <p class="phase__text">{phase.text}</p>
                {phase.achievements.length > 0 && (
                  <ul class="phase__achievements">
                    {phase.achievements.map((a) => (
                      <li>{a}</li>
                    ))}
                  </ul>
                )}
                {phase.stack.length > 0 && (
                  <ul class="phase__stack" aria-label="Tecnologías">
                    {phase.stack.map((t) => (
                      <li class="tag">{t}</li>
                    ))}
                  </ul>
                )}
                {phase.projects.length > 0 && (
                  <div class="phase__projects">
                    <p class="eyebrow">Proyectos de esta etapa</p>
                    <ul>
                      {phase.projects.map((p) => {
                        const link = projectHref(p);
                        return (
                          <li class="project logo-host">
                            <div class="project__main">
                              {link ? (
                                <a
                                  class="project__title"
                                  href={link.href}
                                  {...(link.external ? { rel: 'noopener', target: '_blank' } : {})}
                                >
                                  {p.data.title} <span aria-hidden="true">{link.external ? '↗' : '→'}</span>
                                  {link.external && <span class="sr-only">(abre en otra pestaña)</span>}
                                </a>
                              ) : (
                                <span class="project__title">{p.data.title}</span>
                              )}
                              <p class="muted project__summary">{p.data.summary}</p>
                            </div>
                            <p class="mono muted project__meta">
                              {p.data.featured ? (
                                <span class="badge-case">CASO</span>
                              ) : (
                                p.data.status !== 'live' && statusLabel[p.data.status]
                              )}
                              <span>{formatYears(p.data)}</span>
                            </p>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {
      next.id !== entry.id && (
        <nav class="next card card--interactive logo-host" aria-label="Siguiente empresa">
          <a href={companyHref(next)}>
            <span class="eyebrow">Siguiente experiencia</span>
            <span class="next__row">
              <Logo id={next.data.logo} scale={0.9} />
              <span class="next__title">
                {next.data.role} · {next.data.company} →
              </span>
            </span>
          </a>
        </nav>
      )
    }
  </article>
</Shell>

<style>
  .company {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 780px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    min-height: 44px;
    font-size: 13px;
    text-decoration: none;
    color: var(--muted);
  }

  .back:hover {
    color: var(--ink);
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .header :global(.header__logo) {
    margin-bottom: 4px;
  }

  .title {
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .now {
    display: inline-block;
    vertical-align: middle;
    margin-left: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--on-yellow);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0;
  }

  .summary {
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
  }

  /* Three highlights as a strip of cards */
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .highlights li {
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-top: 4px solid var(--yellow);
    border-radius: 10px;
    background: var(--surface);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.45;
  }

  .phases {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .phase-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Vertical timeline: period on the left, a rail with a dot, content on the right */
  .phase {
    position: relative;
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 32px;
    padding-bottom: 40px;
    scroll-margin-top: 32px;
  }

  .phase::before {
    content: '';
    position: absolute;
    left: 156px;
    top: 10px;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  .phase:last-child::before {
    display: none;
  }

  .phase::after {
    content: '';
    position: absolute;
    left: 151px;
    top: 5px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 4px var(--paper);
  }

  .phase:target .phase__title {
    background: linear-gradient(transparent 56%, var(--hl) 56%, var(--hl) 94%, transparent 94%);
  }

  .phase__period {
    font-size: 13px;
    color: var(--muted);
    padding-top: 2px;
  }

  .phase__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 12px;
  }

  .phase__title {
    font-size: 22px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.015em;
    align-self: flex-start;
  }

  .phase__role {
    font-size: 13px;
    margin-top: -6px;
  }

  .phase__text {
    font-size: 16px;
    line-height: 1.65;
  }

  .phase__achievements {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    line-height: 1.55;
  }

  .phase__achievements li::marker {
    color: var(--muted);
  }

  .phase__stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .phase__projects {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 8px;
  }

  .phase__projects ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .project__main {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .project__title {
    font-weight: 600;
    font-size: 16px;
  }

  a.project__title {
    text-decoration: none;
  }

  a.project__title:hover {
    text-decoration: underline;
    text-decoration-color: var(--mag);
  }

  .project__summary {
    font-size: 14px;
    line-height: 1.5;
  }

  .project__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    font-size: 11px;
    text-align: right;
    white-space: nowrap;
  }

  .next a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    text-decoration: none;
    color: var(--ink);
  }

  .next__row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .next__title {
    font-size: 18px;
    font-weight: 600;
  }

  .next:hover .next__title {
    color: var(--mag);
  }

  @media (max-width: 640px) {
    .phase {
      grid-template-columns: 1fr;
      gap: 8px;
      padding-left: 22px;
    }
    .phase::before {
      left: 5px;
      top: 14px;
    }
    .phase::after {
      left: 0;
    }
    .phase__body {
      padding-left: 0;
    }
    .project {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .project__meta {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
