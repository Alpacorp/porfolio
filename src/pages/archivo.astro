---
import Shell from '../layouts/Shell.astro';
import ArchiveTable from '../components/ArchiveTable.astro';
import BackLink from '../components/BackLink.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
---

<Shell title="Archivo de proyectos" description="Todos los proyectos de Alejandro Palacios: banca, fintech, e-commerce, agencias y freelance.">
  <section class="page">
    <BackLink href="/#archivo" label="Inicio" />
    <header class="header">
      <p class="eyebrow">Archivo</p>
      <h1 class="title">Todo lo que he construido</h1>
      <p class="muted lead">
        Empleo y freelance en una sola lista. Filtra por tipo o sector, o busca por cliente o tecnología. Los
        proyectos con <span class="badge-case">CASO</span> tienen su historia completa.
      </p>
    </header>
    <ArchiveTable projects={projects} total={projects.length} full />
  </section>
</Shell>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .title {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .lead {
    font-size: 17px;
    line-height: 1.55;
    max-width: 640px;
  }
</style>
