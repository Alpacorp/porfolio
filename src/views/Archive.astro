---
import Shell from '../layouts/Shell.astro';
import ArchiveTable from '../components/ArchiveTable.astro';
import BackLink from '../components/BackLink.astro';
import { getProjects } from '../lib/projects';
import { href, langFromPath, otherLang } from '../i18n';
import { useT } from '../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const projects = await getProjects(lang);
const meta = {
  es: {
    title: 'Archivo de proyectos',
    description: 'Todos los proyectos de Alejandro Palacios: banca, fintech, e-commerce, agencias y freelance.',
  },
  en: {
    title: 'Project archive',
    description: 'Every project by Alejandro Palacios: banking, fintech, e-commerce, agencies and freelance.',
  },
}[lang];
---

<Shell title={meta.title} description={meta.description} alternate={href(otherLang(lang), { name: 'archive' })}>
  <section class="page">
    <BackLink href={href(lang, { name: 'home' })} label={t.home} />
    <header class="header">
      <p class="eyebrow">{t.archiveEyebrow}</p>
      <h1 class="title">{t.archiveTitle}</h1>
      <p class="muted lead">
        {t.archiveLead} <span class="badge-case">{t.caseBadge}</span> {t.archiveLeadEnd}
      </p>
    </header>
    <ArchiveTable projects={projects} total={projects.length} full />
  </section>
</Shell>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .title {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .lead {
    font-size: 17px;
    line-height: 1.55;
    max-width: 640px;
  }
</style>
