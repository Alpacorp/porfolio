---
import Shell from '../layouts/Shell.astro';
import BackLink from '../components/BackLink.astro';
import Logo from '../components/Logo.astro';
import { companyHref, resolvePhases, type Company } from '../lib/experience';
import { formatYears, projectHref, statusLabel } from '../lib/projects';
import { href, section } from '../i18n';
import { getI18n } from '../i18n/ui';

interface Props {
  entry: Company;
  next: Company;
}

const { lang, otherLang, ui } = getI18n(Astro.url);
const { entry, next } = Astro.props;
const company = entry.data;
const phases = await resolvePhases(entry, lang);
---

<Shell
  title={`${company.role} · ${company.company}`}
  description={company.summary}
  alternate={href(otherLang, { name: 'experience', id: entry.id })}
>
  <article class="company">
    <BackLink href={section(lang, 'experiencia')} label={ui.allExperience} />

    <header class="header logo-host">
      <Logo id={company.logo} scale={1.3} class="header__logo" />
      <p class="eyebrow">
        {company.company} · {company.start} — {company.end} · {company.location}
      </p>
      <h1 class="page-title">
        {company.role}{' '}
        {company.current && <span class="pill-now">{ui.current}</span>}
      </h1>
      <p class="summary">{company.summary}</p>
    </header>

    <ul class="highlights">
      {company.highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>

    <section class="phases" aria-labelledby="etapas-titulo">
      <h2 id="etapas-titulo" class="eyebrow">{ui.phases}</h2>
      <ol class="phase-list">
        {
          phases.map((phase) => (
            <li class="phase" id={phase.id}>
              <p class="phase__period mono">{phase.period}</p>
              <div class="phase__body">
                <h3 class="phase__title">{phase.title}</h3>
                {phase.role && <p class="mono muted phase__role">{phase.role}</p>}
                <p class="phase__text">{phase.text}</p>
                {phase.achievements.length > 0 && (
                  <ul class="phase__achievements">
                    {phase.achievements.map((achievement) => (
                      <li>{achievement}</li>
                    ))}
                  </ul>
                )}
                {phase.stack.length > 0 && (
                  <ul class="phase__stack" aria-label={ui.technologies}>
                    {phase.stack.map((technology) => (
                      <li class="tag">{technology}</li>
                    ))}
                  </ul>
                )}
                {phase.projects.length > 0 && (
                  <div class="phase__projects">
                    <p class="eyebrow">{ui.phaseProjects}</p>
                    <ul>
                      {phase.projects.map((project) => {
                        const link = projectHref(project, lang);
                        return (
                          <li class="project logo-host">
                            <div class="project__main">
                              {link ? (
                                <a
                                  class="project__title"
                                  href={link.href}
                                  {...(link.external ? { rel: 'noopener', target: '_blank' } : {})}
                                >
                                  {project.data.title} <span aria-hidden="true">{link.external ? '↗' : '→'}</span>
                                  {link.external && <span class="sr-only">{ui.opensNewTab}</span>}
                                </a>
                              ) : (
                                <span class="project__title">{project.data.title}</span>
                              )}
                              <p class="muted project__summary">{project.data.summary}</p>
                            </div>
                            <p class="mono muted project__meta">
                              {project.data.featured ? (
                                <span class="badge-case">{ui.caseBadge}</span>
                              ) : (
                                project.data.status !== 'live' && statusLabel(project.data.status, lang)
                              )}
                              <span>{formatYears(project.data, lang)}</span>
                            </p>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {
      next.id !== entry.id && (
        <nav class="next card card--interactive logo-host" aria-label={ui.nextExperience}>
          <a href={companyHref(next, lang)}>
            <span class="eyebrow">{ui.nextExperience}</span>
            <span class="next__row">
              <Logo id={next.data.logo} scale={0.9} />
              <span class="next__title">
                {next.data.role} · {next.data.company} →
              </span>
            </span>
          </a>
        </nav>
      )
    }
  </article>
</Shell>

<style>
  .company {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 780px;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .header :global(.header__logo) {
    margin-bottom: 4px;
  }

  /* A notch smaller than other pages: role titles run long */
  .company .page-title {
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.08;
  }

  .page-title .pill-now {
    margin-left: 10px;
    padding: 4px 10px;
    font-size: 12px;
    letter-spacing: 0;
  }

  .summary {
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
  }

  /* Three highlights as a strip of cards */
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .highlights li {
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-top: 4px solid var(--yellow);
    border-radius: 10px;
    background: var(--surface);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.45;
  }

  .phases {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .phase-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Vertical timeline: period on the left, a rail with a dot, content on the right */
  .phase {
    position: relative;
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 32px;
    padding-bottom: 40px;
    scroll-margin-top: 32px;
  }

  .phase::before {
    content: '';
    position: absolute;
    left: 156px;
    top: 10px;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  .phase:last-child::before {
    display: none;
  }

  .phase::after {
    content: '';
    position: absolute;
    left: 151px;
    top: 5px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 4px var(--paper);
  }

  .phase:target .phase__title {
    background: var(--hl-band);
  }

  .phase__period {
    font-size: 13px;
    color: var(--muted);
    padding-top: 2px;
  }

  .phase__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 12px;
  }

  .phase__title {
    font-size: 22px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.015em;
    align-self: flex-start;
  }

  .phase__role {
    font-size: 13px;
    margin-top: -6px;
  }

  .phase__text {
    font-size: 16px;
    line-height: 1.65;
  }

  .phase__achievements {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    line-height: 1.55;
  }

  .phase__achievements li::marker {
    color: var(--muted);
  }

  .phase__stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .phase__projects {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 8px;
  }

  .phase__projects ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .project__main {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .project__title {
    font-weight: 600;
    font-size: 16px;
  }

  a.project__title {
    text-decoration: none;
  }

  a.project__title:hover {
    text-decoration: underline;
    text-decoration-color: var(--mag);
  }

  .project__summary {
    font-size: 14px;
    line-height: 1.5;
  }

  .project__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    font-size: 11px;
    text-align: right;
    white-space: nowrap;
  }

  .next a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    text-decoration: none;
    color: var(--ink);
  }

  .next__row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .next__title {
    font-size: 18px;
    font-weight: 600;
  }

  .next:hover .next__title {
    color: var(--mag);
  }

  @media (max-width: 640px) {
    .phase {
      grid-template-columns: 1fr;
      gap: 8px;
      padding-left: 22px;
    }
    .phase::before {
      left: 5px;
      top: 14px;
    }
    .phase::after {
      left: 0;
    }
    .phase__body {
      padding-left: 0;
    }
    .project {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .project__meta {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
