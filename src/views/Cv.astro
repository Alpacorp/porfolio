---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { education, educationLinks, skills } from '../data/career';
import { getExperienceItems } from '../lib/experience';
import { profile } from '../data/profile';
import { getCases } from '../lib/projects';
import { href, langFromPath, otherLang } from '../i18n';
import { useT } from '../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const other = otherLang(lang);
const t = useT(lang);
const [allCases, experience] = await Promise.all([getCases(lang), getExperienceItems(lang)]);
// Employment case studies are already summarised under «Experience»; the printed
// CV only adds the freelance ones, which have no other place in it.
const cases = allCases.filter((c) => c.data.kind === 'freelance');
---

<Base title={t.cvTitle} description={t.cvDescription(profile.fullName, profile.role)} alternate={href(other, { name: 'cv' })}>
  <main id="contenido" class="cv" tabindex="-1">
    <div class="toolbar no-print">
      <a class="mono back" href={href(lang, { name: 'home' })}><Icon name="arrow-left" size={16} /> alpacorp.net</a>
      <div class="toolbar__actions">
        <a class="icon-btn lang-btn mono" href={href(other, { name: 'cv' })} hreflang={other} lang={other} aria-label={t.switchLanguage} title={t.switchLanguage}>
          {other.toUpperCase()}
        </a>
        <button class="btn btn--dark" type="button" data-print><Icon name="print" size={16} /> {t.print}</button>
      </div>
    </div>

    <header class="header">
      <h1 class="name">{profile.fullName}</h1>
      <p class="role">{t.roleAt(profile.role, profile.current)}</p>
      <p class="focus muted">{profile.focus[lang]}</p>
      <ul class="mono muted contact">
        <li>{profile.location}</li>
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={profile.links.linkedin} rel="noopener" target="_blank">linkedin.com/in/alejandro-palacios88</a></li>
        <li><a href={profile.links.github} rel="noopener" target="_blank">github.com/Alpacorp</a></li>
        <li><a href={href(lang, { name: 'home' })}>{profile.site}</a></li>
      </ul>
    </header>

    <section>
      <h2 class="eyebrow">{t.profileHeading}</h2>
      {
        lang === 'es' ? (
          <p>
            Software Engineer en Mercado Libre / Mercado Pago y desarrollador freelance desde 2019. Más de 9 años
            construyendo productos digitales para banca, fintech, e-commerce, logística y agencias. React,
            TypeScript, Next.js, Node.js y Go, integración de APIs, pruebas, automatización e IA aplicada al
            desarrollo. Hablo tres idiomas en un equipo: <span class="hl">negocio, marketing y código</span>.
          </p>
        ) : (
          <p>
            Software Engineer at Mercado Libre / Mercado Pago and freelance developer since 2019. 9+ years
            building digital products for banking, fintech, e-commerce, logistics and agencies. React,
            TypeScript, Next.js, Node.js and Go, API integration, testing, automation and AI built into the
            development workflow. I speak three languages on a team: <span class="hl">business, marketing and code</span>.
          </p>
        )
      }
    </section>

    <section>
      <h2 class="eyebrow">{t.experienceHeading}</h2>
      <ol class="list">
        {
          experience.map((job) => (
            <li class="item">
              <div class="item__head">
                <h3>
                  {job.role} · {job.company}
                </h3>
                <span class="mono muted">{job.dates}</span>
              </div>
              <p>{job.summary}</p>
              <ul class="bullets">
                {job.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
              <p class="mono muted small">{job.stack.join(' · ')}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="projects">
      <h2 class="eyebrow">{t.freelanceHighlights}</h2>
      <ul class="list">
        {
          cases.map((c) => (
            <li class="item">
              <div class="item__head">
                <h3>
                  <a href={href(lang, { name: 'case', id: c.id })}>{c.data.title}</a>
                </h3>
                <span class="mono muted">{c.data.client}</span>
              </div>
              <p>{c.data.summary}</p>
              {c.data.metric && (
                <p class="result">
                  <span class="mono muted">{t.result}</span>
                  <strong>
                    {c.data.metric.value} {c.data.metric.label}
                  </strong>
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="two-col">
      <div>
        <h2 class="eyebrow">{t.educationHeading}</h2>
        <ul class="list list--tight">
          {
            education.map((e) => (
              <li class="item">
                <h3>{e.title[lang]}</h3>
                <p class="mono muted small">
                  {e.org} · {e.dates}
                </p>
              </li>
            ))
          }
        </ul>
        <p class="small links">
          <a href={educationLinks.education} rel="noopener" target="_blank">{t.educationFull}</a> {t.and}{' '}
          <a href={educationLinks.certifications} rel="noopener" target="_blank">{t.certificatesLower}</a> {t.on}{' '}
          <span class="mono">linkedin.com/in/alejandro-palacios88</span>
        </p>
      </div>
      <div>
        <h2 class="eyebrow">{t.skillsHeading}</h2>
        <dl class="skills">
          {
            skills[lang].map((s) => (
              <div>
                <dt>{s.area}</dt>
                <dd class="muted">{s.items}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  </main>
</Base>

<style>
  .cv {
    max-width: 820px;
    margin: 0 auto;
    padding: 48px var(--gutter) 80px;
    display: flex;
    flex-direction: column;
    gap: 36px;
    font-size: 15px;
    line-height: 1.6;
    outline: none;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .toolbar__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang-btn {
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 13px;
    text-decoration: none;
    color: var(--muted);
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--ink);
  }

  .name {
    font-size: clamp(32px, 5vw, 44px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .role {
    font-size: 17px;
    font-weight: 500;
  }

  .focus {
    font-size: 14px;
    margin-top: -4px;
  }

  .bullets {
    margin: 2px 0;
    padding-left: 18px;
  }

  .bullets li::marker {
    color: var(--muted);
  }

  .result {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
  }

  .result .mono {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .list--tight {
    gap: 12px;
  }

  .links a {
    font-weight: 500;
  }

  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    font-size: 12px;
    line-height: 1.7;
  }

  .contact li:not(:last-child)::after {
    content: '·';
    margin: 0 8px;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    break-inside: avoid;
  }

  .item__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  .item h3 {
    font-size: 16px;
    font-weight: 600;
  }

  .item__head .mono {
    font-size: 12px;
  }

  .small {
    font-size: 12px;
  }

  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
  }

  .two-col > div {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .skills {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .skills dt {
    font-weight: 600;
    font-size: 14px;
  }

  .skills dd {
    margin: 0;
    font-size: 14px;
  }

  .skills > div {
    break-inside: avoid;
  }

  @media print {
    .cv {
      padding: 0;
      max-width: none;
      font-size: 10pt;
      line-height: 1.4;
      gap: 12pt;
    }
    section {
      gap: 8pt;
    }
    .list {
      gap: 8pt;
    }
    /* Education fits in a compact list on paper */
    .list--tight {
      gap: 5pt;
    }
    .list--tight .item h3 {
      font-size: 10pt;
    }
    .header {
      padding-bottom: 12pt;
    }
    .name {
      font-size: 26pt;
    }
    .item h3 {
      font-size: 11pt;
    }
    .skills dt,
    .skills dd {
      font-size: 9.5pt;
    }
    .skills {
      gap: 6pt;
    }
    .two-col {
      gap: 20pt;
    }
    /* Keep section titles with their content instead of forcing page breaks */
    h2 {
      break-after: avoid;
    }
    .item,
    .skills > div {
      break-inside: avoid;
    }
    @page {
      margin: 12mm 13mm;
    }
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
