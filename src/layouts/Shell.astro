---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileNav from '../components/MobileNav.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  /** Same page in the other language (see Base). */
  alternate?: string;
  noindex?: boolean;
}

const { title, description, home = false, alternate, noindex } = Astro.props;
---

<Base title={title} description={description} alternate={alternate} noindex={noindex}>
  <div class="shell">
    <Sidebar home={home} alternate={alternate} />
    <MobileNav home={home} />
    <div class="column">
      <main id="contenido" class="main" tabindex="-1">
        <slot />
      </main>
      <!-- Outside <main>, so it keeps its contentinfo landmark -->
      <footer class="footer mono">
        <span>© {new Date().getFullYear()} {profile.name} · {profile.site}</span>
      </footer>
    </div>
  </div>
</Base>

<style>
  .shell {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(32px, 6vw, 72px) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  @media (min-width: 1024px) {
    .shell {
      flex-direction: row;
      gap: clamp(56px, 6vw, 88px);
    }
  }

  .column {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 8vw, 88px);
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 8vw, 88px);
    outline: none;
  }

  /* Section divider: an ink rule with a yellow tab at the start.
     The (yellow) contact block is a divider on its own. */
  .main > :global(section:not(:first-child):not(.contact))::before {
    content: '';
    display: block;
    height: 5px;
    margin-bottom: 12px;
    background:
      linear-gradient(var(--yellow), var(--yellow)) left top / 56px 5px no-repeat,
      linear-gradient(var(--ink), var(--ink)) left bottom / 100% 1px no-repeat;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    font-size: 12px;
    color: var(--muted);
    padding-bottom: 24px;
  }
</style>
