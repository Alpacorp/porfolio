---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileNav from '../components/MobileNav.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
---

<Base title={title} description={description}>
  <div class="shell">
    <Sidebar home={home} />
    <MobileNav home={home} />
    <main id="contenido" class="main" tabindex="-1">
      <slot />
      <footer class="footer mono">
        <span>© {new Date().getFullYear()} {profile.name} · {profile.site}</span>
        <span>Hecho con Astro</span>
      </footer>
    </main>
  </div>
</Base>

<style>
  .shell {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(32px, 6vw, 72px) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  @media (min-width: 1024px) {
    .shell {
      flex-direction: row;
      gap: clamp(56px, 6vw, 88px);
    }
  }

  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 8vw, 88px);
    outline: none;
  }

  /* Separador entre secciones: línea en color de texto con una pestaña amarilla al inicio.
     El bloque de contacto (amarillo) ya separa por sí mismo. */
  .main > :global(section:not(:first-child):not(.contact))::before {
    content: '';
    display: block;
    height: 5px;
    margin-bottom: 12px;
    background:
      linear-gradient(var(--yellow), var(--yellow)) left top / 56px 5px no-repeat,
      linear-gradient(var(--ink), var(--ink)) left bottom / 100% 1px no-repeat;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    font-size: 12px;
    color: var(--muted);
    padding-bottom: 24px;
  }
</style>
