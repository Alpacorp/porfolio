---
import '../styles/global.css';
// The two fonts every page shows above the fold; preloading them avoids the
// text reflowing when they swap in. Same files global.css uses, so no double download.
import geistFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoFont from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import CommandPalette from '../components/CommandPalette.astro';
import { profile } from '../data/profile';
import { href, locale } from '../i18n';
import { getI18n } from '../i18n/ui';
import { alternateLinks, pageTitle } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Same page in the other language; defaults to its home page. */
  alternate?: string;
  /** Keep the page out of search results (the 404), with no canonical or translations. */
  noindex?: boolean;
}

const { lang, otherLang, ui } = getI18n(Astro.url);
const {
  title,
  description = profile.description[lang],
  alternate = href(otherLang, { name: 'home' }),
  noindex = false,
} = Astro.props;
const site = Astro.site!;
const fullTitle = pageTitle(title, profile.name, profile.role);
const canonical = new URL(Astro.url.pathname, site);
// Share card with photo, name and role in the page language; social networks need an absolute URL.
const ogImage = new URL(locale[lang].shareImage, site);
---

<!doctype html>
<html lang={locale[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {alternateLinks(site, Astro.url.pathname, lang, alternate).map((link) => (
            <link rel="alternate" hreflang={link.hreflang} href={link.href} />
          ))}
        </>
      )
    }
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f6f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0e" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale[lang].og} />
    <meta property="og:locale:alternate" content={locale[otherLang].og} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${ui.roleAt(profile.role, profile.current)}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- Apply the saved theme before first paint to avoid a flash -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch (error) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{ui.skipToContent}</a>
    <slot />
    <CommandPalette alternate={alternate} />

    <!-- Safety net: every link to another site opens in a new tab, MDX content included -->
    <script>
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]')) {
        if (link.host === location.host || link.target) continue;
        link.target = '_blank';
        link.relList.add('noopener');
      }
    </script>
  </body>
</html>
