---
import { formatYears, projectHref, statusLabel, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
  /** Total para el contador («X de N»). */
  total: number;
  /** Página completa: añade buscador y filtro por sector. */
  full?: boolean;
}

const { projects, total, full = false } = Astro.props;
const sectors = [...new Set(projects.map((p) => p.data.sector))].sort((a, b) => a.localeCompare(b, 'es'));
const filters = ['Todo', 'Casos', 'Empleo', 'Freelance'];
---

<div class="archive" data-archive>
  <div class="toolbar">
    <div class="filters" role="group" aria-label="Filtrar proyectos">
      {
        filters.map((f, i) => (
          <button class="chip" type="button" aria-pressed={i === 0 ? "true" : "false"} data-kind={f}>
            {f}
          </button>
        ))
      }
    </div>
    {
      full && (
        <div class="search">
          <label class="sr-only" for="archive-search">Buscar proyecto, cliente o tecnología</label>
          <input
            id="archive-search"
            type="search"
            placeholder="Buscar cliente, sector o tecnología…"
            autocomplete="off"
            data-search
          />
          <label class="sr-only" for="archive-sector">Sector</label>
          <select id="archive-sector" data-sector>
            <option value="">Todos los sectores</option>
            {sectors.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
      )
    }
    <p class="count mono muted" aria-live="polite" data-count>
      {projects.length} de {total} proyectos
    </p>
  </div>

  <table class="table">
    <thead class="mono">
      <tr>
        <th scope="col">Año</th>
        <th scope="col">Proyecto</th>
        <th scope="col" class="col-sector">Sector</th>
        <th scope="col" class="col-stack">Stack</th>
        <th scope="col"><span class="sr-only">Enlace</span></th>
      </tr>
    </thead>
    <tbody>
      {
        projects.map((p) => {
          const link = projectHref(p);
          const search = [p.data.title, p.data.client, p.data.via, p.data.sector, ...p.data.stack]
            .filter(Boolean)
            .join(' ')
            .toLowerCase();
          return (
            <tr
              data-row
              data-kind={p.data.kind === 'empleo' ? 'Empleo' : 'Freelance'}
              data-case={String(p.data.featured)}
              data-sector={p.data.sector}
              data-search={search}
            >
              <td class="mono muted col-year">{formatYears(p.data)}</td>
              <td>
                {link ? (
                  <a class="row-link" href={link.href} {...(link.external ? { rel: 'noopener', target: '_blank' } : {})}>
                    {p.data.title}
                    {link.external && <span class="sr-only">(abre en otra pestaña)</span>}
                  </a>
                ) : (
                  <span class="row-title">{p.data.title}</span>
                )}
                <span class="client mono muted">
                  {p.data.client}
                  {p.data.via && ` · vía ${p.data.via}`}
                  {!link && p.data.status !== 'live' && ` · ${statusLabel[p.data.status].toLowerCase()}`}
                </span>
              </td>
              <td class="muted col-sector">{p.data.sector}</td>
              <td class="mono muted col-stack">{p.data.stack.slice(0, 3).join(', ')}</td>
              <td class="col-mark mono">
                {p.data.featured ? (
                  <span class="badge-case">CASO</span>
                ) : link ? (
                  <span class="muted" aria-hidden="true">↗</span>
                ) : null}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
  <p class="empty mono muted" data-empty hidden>Ningún proyecto coincide con ese filtro.</p>
</div>

<style>
  .archive {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .search {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1 1 100%;
    order: 3;
  }

  .search input,
  .search select {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 15px;
  }

  .search input {
    flex: 1 1 260px;
  }

  .count {
    font-size: 12px;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  thead th {
    text-align: left;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0 16px 12px 0;
    border-bottom: 1px solid var(--ink);
  }

  td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
  }

  tr[hidden] {
    display: none;
  }

  tbody tr:hover {
    background: var(--surface);
  }

  .col-year {
    width: 96px;
    font-size: 13px;
    white-space: nowrap;
  }

  .col-sector {
    width: 150px;
    font-size: 14px;
  }

  .col-stack {
    width: 190px;
    font-size: 12px;
    line-height: 1.5;
  }

  .col-mark {
    width: 56px;
    text-align: right;
    padding-right: 0;
  }

  .row-link,
  .row-title {
    font-weight: 500;
  }

  .row-link {
    text-decoration: none;
  }

  .row-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--mag);
  }

  /* Toda la fila es clicable a través de su enlace */
  tbody tr:has(.row-link) {
    cursor: pointer;
  }

  .client {
    display: block;
    margin-top: 4px;
    font-size: 11px;
  }

  .empty {
    padding: 24px 0;
    font-size: 13px;
  }

  @media (max-width: 720px) {
    .col-sector,
    .col-stack {
      display: none;
    }
    .col-year {
      width: 64px;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-archive]')) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-kind]')].filter((el) => el.tagName === 'BUTTON');
    const rows = [...root.querySelectorAll<HTMLTableRowElement>('[data-row]')];
    const search = root.querySelector<HTMLInputElement>('[data-search]');
    const sector = root.querySelector<HTMLSelectElement>('[data-sector]');
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const total = count.textContent!.trim().split(' de ')[1];
    let kind = 'Todo';

    const normalize = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();

    function apply() {
      const q = normalize(search?.value.trim() ?? '');
      const s = sector?.value ?? '';
      let shown = 0;
      for (const row of rows) {
        const byKind = kind === 'Todo' || (kind === 'Casos' ? row.dataset.case === 'true' : row.dataset.kind === kind);
        const bySector = !s || row.dataset.sector === s;
        const byText = !q || normalize(row.dataset.search!).includes(q);
        row.hidden = !(byKind && bySector && byText);
        if (!row.hidden) shown++;
      }
      count.textContent = `${shown} de ${total}`;
      empty.hidden = shown > 0;
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        kind = chip.dataset.kind!;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        apply();
      });
    }
    search?.addEventListener('input', apply);
    sector?.addEventListener('change', apply);

    // Clic en cualquier parte de la fila sigue su enlace.
    for (const row of rows) {
      const link = row.querySelector<HTMLAnchorElement>('.row-link');
      if (!link) continue;
      row.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        link.click();
      });
    }
  }
</script>
