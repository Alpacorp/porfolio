---
import Logo from './Logo.astro';
import { formatYears, projectHref, statusLabel, type Project } from '../lib/projects';
import { langFromPath } from '../i18n';
import { sectorName, useT } from '../i18n/ui';
import { N } from '../lib/filters';

interface Props {
  projects: Project[];
  /** Total for the counter («X of N»). */
  total: number;
  /** Full page: adds the search box and the sector filter. */
  full?: boolean;
  /** The home page shows a short preview without filters: filtering a partial list is misleading. */
  filters?: boolean;
}

const { projects, total, full = false, filters: showFilters = true } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const sectors = [...new Set(projects.map((p) => p.data.sector))]
  .map((key) => ({ key, name: sectorName(key, lang) }))
  .sort((a, b) => a.name.localeCompare(b.name, lang));
// Keys stay in Spanish: they match the data and the ?tipo= deep links.
const filters = [
  { key: 'Todo', label: t.filterAll },
  { key: 'Casos', label: t.filterCases },
  { key: 'Empleo', label: t.employment },
  { key: 'Freelance', label: t.freelance },
];
---

<div class="archive" data-archive>
  <div class="toolbar">
    {showFilters && (
    <div class="filters" role="group" aria-label={t.filterProjects}>
      {
        filters.map((f, i) => (
          <button class="chip" type="button" aria-pressed={i === 0 ? "true" : "false"} data-kind={f.key}>
            {f.label}
          </button>
        ))
      }
    </div>
    )}
    {
      full && (
        <div class="search">
          <label class="sr-only" for="archive-search">{t.searchLabel}</label>
          <input
            id="archive-search"
            type="search"
            placeholder={t.searchPlaceholder}
            autocomplete="off"
            data-search
          />
          <label class="sr-only" for="archive-sector">{t.sector}</label>
          <select id="archive-sector" data-sector>
            <option value="">{t.allSectors}</option>
            {sectors.map((s) => <option value={s.key}>{s.name}</option>)}
          </select>
        </div>
      )
    }
    {
      showFilters ? (
        <p
          class="count mono muted"
          aria-live="polite"
          data-count
          data-template={t.countOf(N, total)}
        >
          {t.countOf(projects.length, total)}
        </p>
      ) : (
        <p class="count mono muted">{t.latestOf(projects.length, total)}</p>
      )
    }
  </div>

  <table class="table">
    <thead class="mono">
      <tr>
        <th scope="col">{t.colYear}</th>
        <th scope="col" class="col-logo"><span class="sr-only">{t.colClient}</span></th>
        <th scope="col">{t.colProject}</th>
        <th scope="col" class="col-sector">{t.colSector}</th>
        <th scope="col" class="col-stack">{t.colStack}</th>
        <th scope="col"><span class="sr-only">{t.colLink}</span></th>
      </tr>
    </thead>
    <tbody>
      {
        projects.map((p) => {
          const link = projectHref(p, lang);
          const sector = sectorName(p.data.sector, lang);
          const search = [p.data.title, p.data.client, p.data.via, sector, ...p.data.stack]
            .filter(Boolean)
            .join(' ')
            .toLowerCase();
          return (
            <tr
              class="logo-host"
              data-row
              data-kind={p.data.kind === 'empleo' ? 'Empleo' : 'Freelance'}
              data-case={String(p.data.featured)}
              data-sector={p.data.sector}
              data-search={search}
            >
              <td class="mono muted col-year">{formatYears(p.data, lang)}</td>
              <td class="col-logo">{p.data.logo && <Logo id={p.data.logo} scale={0.7} />}</td>
              <td>
                {link ? (
                  <a class="row-link" href={link.href} {...(link.external ? { rel: 'noopener', target: '_blank' } : {})}>
                    {p.data.title}
                    {link.external && <span class="sr-only">{t.opensNewTab}</span>}
                  </a>
                ) : (
                  <span class="row-title">{p.data.title}</span>
                )}
                <span class="client mono muted">
                  {p.data.client}
                  {p.data.via && ` · ${t.via(p.data.via)}`}
                  {!link && p.data.status !== 'live' && ` · ${statusLabel(p.data.status, lang).toLowerCase()}`}
                </span>
              </td>
              <td class="muted col-sector">{sector}</td>
              <td class="mono muted col-stack">{p.data.stack.slice(0, 3).join(', ')}</td>
              <td class="col-mark mono">
                {p.data.featured ? (
                  <span class="badge-case">{t.caseBadge}</span>
                ) : link ? (
                  <span class="muted" aria-hidden="true">↗</span>
                ) : null}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
  <p class="empty mono muted" data-empty hidden>{t.noMatches}</p>
</div>

<style>
  .archive {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .search {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1 1 100%;
    order: 3;
  }

  .search input,
  .search select {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 15px;
  }

  .search input {
    flex: 1 1 260px;
  }

  .count {
    font-size: 12px;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  thead th {
    text-align: left;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0 16px 12px 0;
    border-bottom: 1px solid var(--ink);
  }

  td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
  }

  tr[hidden] {
    display: none;
  }

  tbody tr:hover {
    background: var(--surface);
  }

  .col-year {
    width: 96px;
    font-size: 13px;
    white-space: nowrap;
  }

  .col-logo {
    width: 100px;
    vertical-align: top;
    padding-top: 12px;
  }

  .col-sector {
    width: 120px;
    font-size: 14px;
  }

  .col-stack {
    width: 160px;
    font-size: 12px;
    line-height: 1.5;
  }

  .col-mark {
    width: 56px;
    text-align: right;
    padding-right: 0;
  }

  .row-link,
  .row-title {
    font-weight: 500;
  }

  .row-link {
    text-decoration: none;
  }

  .row-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--mag);
  }

  /* Toda la fila es clicable a través de su enlace */
  tbody tr:has(.row-link) {
    cursor: pointer;
  }

  .client {
    display: block;
    margin-top: 4px;
    font-size: 11px;
  }

  .empty {
    padding: 24px 0;
    font-size: 13px;
  }

  @media (max-width: 720px) {
    .col-sector,
    .col-stack,
    .col-logo {
      display: none;
    }
    .col-year {
      width: 64px;
    }
  }
</style>

<script>
  import { fill, matchesArchive } from '../lib/filters';

  for (const root of document.querySelectorAll<HTMLElement>('[data-archive]')) {
    // Rows also carry data-kind / data-search / data-sector, so target the controls by tag.
    const rows = [...root.querySelectorAll<HTMLTableRowElement>('tr[data-row]')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('button[data-kind]')];
    const search = root.querySelector<HTMLInputElement>('input[data-search]');
    const sector = root.querySelector<HTMLSelectElement>('select[data-sector]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');

    // Filters only exist on the full archive page.
    if (count && empty) {
      const template = count.dataset.template ?? '';
      let kind = 'Todo';

      const apply = () => {
        const query = { kind, sector: sector?.value ?? '', text: search?.value ?? '' };
        let shown = 0;
        for (const row of rows) {
          const { kind: rowKind = '', case: isCase, sector: rowSector = '', search: text = '' } = row.dataset;
          row.hidden = !matchesArchive({ kind: rowKind, isCase: isCase === 'true', sector: rowSector, search: text }, query);
          if (!row.hidden) shown++;
        }
        count.textContent = fill(template, shown);
        empty.hidden = shown > 0;
      };

      for (const chip of chips) {
        chip.addEventListener('click', () => {
          kind = chip.dataset.kind!;
          chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
          apply();
        });
      }
      search?.addEventListener('input', apply);
      sector?.addEventListener('change', apply);

      // Deep link from elsewhere (e.g. the timeline): ?tipo=Freelance preselects that filter.
      const preset = new URLSearchParams(location.search).get('tipo');
      chips.find((c) => c.dataset.kind === preset)?.click();
    }

    // Clicking anywhere on a row follows its link.
    for (const row of rows) {
      const link = row.querySelector<HTMLAnchorElement>('.row-link');
      if (!link) continue;
      row.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        link.click();
      });
    }
  }
</script>
