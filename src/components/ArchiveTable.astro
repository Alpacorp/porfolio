---
import Logo from './Logo.astro';
import {
  formatYears,
  kindKey,
  projectHref,
  searchText,
  sectorOptions,
  statusLabel,
  type Project,
} from '../lib/projects';
import { getI18n, sectorName } from '../i18n/ui';
import { formatCount } from '../lib/filters';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const { lang, ui } = getI18n(Astro.url);
// Keys stay in Spanish: they match the data and the ?tipo= deep links.
const kindFilters = [
  { key: 'Todo', label: ui.filterAll },
  { key: 'Casos', label: ui.filterCases },
  { key: 'Empleo', label: ui.employment },
  { key: 'Freelance', label: ui.freelance },
];
---

<div class="archive" data-archive>
  <div class="toolbar">
    <div class="filters" role="group" aria-label={ui.filterProjects}>
      {
        kindFilters.map((filter, index) => (
          <button class="chip" type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-kind={filter.key}>
            {filter.label}
          </button>
        ))
      }
    </div>
    <div class="search">
      <label class="sr-only" for="archive-search">{ui.searchLabel}</label>
      <input id="archive-search" type="search" placeholder={ui.searchPlaceholder} autocomplete="off" data-search />
      <label class="sr-only" for="archive-sector">{ui.sector}</label>
      <select id="archive-sector" data-sector>
        <option value="">{ui.allSectors}</option>
        {sectorOptions(projects, lang).map((sector) => <option value={sector.key}>{sector.name}</option>)}
      </select>
    </div>
    <p class="count mono muted" aria-live="polite" data-count data-template={JSON.stringify(ui.countOf(projects.length))}>
      {formatCount(ui.countOf(projects.length), projects.length)}
    </p>
  </div>

  <table class="table">
    <thead class="mono">
      <tr>
        <th scope="col">{ui.colYear}</th>
        <th scope="col" class="col-logo"><span class="sr-only">{ui.colClient}</span></th>
        <th scope="col">{ui.colProject}</th>
        <th scope="col" class="col-sector">{ui.colSector}</th>
        <th scope="col" class="col-stack">{ui.colStack}</th>
        <th scope="col"><span class="sr-only">{ui.colLink}</span></th>
      </tr>
    </thead>
    <tbody>
      {
        projects.map((project) => {
          const { data } = project;
          const link = projectHref(project, lang);
          return (
            <tr
              class="logo-host"
              data-row
              data-kind={kindKey(project)}
              data-case={String(data.featured)}
              data-sector={data.sector}
              data-search={searchText(project, lang)}
            >
              <td class="mono muted col-year">{formatYears(data, lang)}</td>
              <td class="col-logo">{data.logo && <Logo id={data.logo} scale={0.7} />}</td>
              <td>
                {link ? (
                  <a class="row-link" href={link.href} {...(link.external ? { rel: 'noopener', target: '_blank' } : {})}>
                    {data.title}
                    {link.external && <span class="sr-only">{ui.opensNewTab}</span>}
                  </a>
                ) : (
                  <span class="row-title">{data.title}</span>
                )}
                <span class="client mono muted">
                  {data.client}
                  {data.via && ` · ${ui.via(data.via)}`}
                  {!link && data.status !== 'live' && ` · ${statusLabel(data.status, lang).toLowerCase()}`}
                </span>
              </td>
              <td class="muted col-sector">{sectorName(data.sector, lang)}</td>
              <td class="mono muted col-stack">{data.stack.slice(0, 3).join(', ')}</td>
              <td class="col-mark mono">
                {data.featured ? (
                  <span class="badge-case">{ui.caseBadge}</span>
                ) : link ? (
                  <span class="muted" aria-hidden="true">↗</span>
                ) : null}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
  <p class="empty mono muted" data-empty hidden>{ui.noMatches}</p>
</div>

<style>
  .archive {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .search {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1 1 100%;
    order: 3;
  }

  .search input,
  .search select {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 15px;
  }

  .search input {
    flex: 1 1 260px;
  }

  .count {
    font-size: 12px;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  thead th {
    text-align: left;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0 16px 12px 0;
    border-bottom: 1px solid var(--ink);
  }

  td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
  }

  tr[hidden] {
    display: none;
  }

  tbody tr:hover {
    background: var(--surface);
  }

  .col-year {
    width: 96px;
    font-size: 13px;
    white-space: nowrap;
  }

  .col-logo {
    width: 100px;
    vertical-align: top;
    padding-top: 12px;
  }

  .col-sector {
    width: 120px;
    font-size: 14px;
  }

  .col-stack {
    width: 160px;
    font-size: 12px;
    line-height: 1.5;
  }

  .col-mark {
    width: 56px;
    text-align: right;
    padding-right: 0;
  }

  .row-link,
  .row-title {
    font-weight: 500;
  }

  .row-link {
    text-decoration: none;
  }

  .row-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--mag);
  }

  /* The whole row is clickable through its link */
  tbody tr:has(.row-link) {
    cursor: pointer;
  }

  .client {
    display: block;
    margin-top: 4px;
    font-size: 11px;
  }

  .empty {
    padding: 24px 0;
    font-size: 13px;
  }

  @media (max-width: 720px) {
    .col-sector,
    .col-stack,
    .col-logo {
      display: none;
    }
    .col-year {
      width: 64px;
    }
  }
</style>

<script>
  import { formatCount, matchesArchive, readPlural } from '../lib/filters';

  const root = document.querySelector<HTMLElement>('[data-archive]');
  if (root) {
    // Rows also carry data-kind / data-search / data-sector, so target the controls by tag.
    const rows = [...root.querySelectorAll<HTMLTableRowElement>('tr[data-row]')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('button[data-kind]')];
    const search = root.querySelector<HTMLInputElement>('input[data-search]')!;
    const sector = root.querySelector<HTMLSelectElement>('select[data-sector]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const emptyMessage = root.querySelector<HTMLElement>('[data-empty]')!;
    const countLabel = readPlural(count.dataset.template);
    let kind = 'Todo';

    const apply = () => {
      const query = { kind, sector: sector.value, text: search.value };
      let shown = 0;
      for (const row of rows) {
        const { kind: rowKind = '', case: isCase, sector: rowSector = '', search: rowText = '' } = row.dataset;
        row.hidden = !matchesArchive({ kind: rowKind, isCase: isCase === 'true', sector: rowSector, search: rowText }, query);
        if (!row.hidden) shown++;
      }
      count.textContent = formatCount(countLabel, shown);
      emptyMessage.hidden = shown > 0;
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        kind = chip.dataset.kind!;
        chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
        apply();
      });
    }
    search.addEventListener('input', apply);
    sector.addEventListener('change', apply);

    // Deep link from elsewhere (e.g. the timeline): ?tipo=Freelance preselects that filter.
    const preset = new URLSearchParams(location.search).get('tipo');
    chips.find((chip) => chip.dataset.kind === preset)?.click();

    // Clicking anywhere on a row follows its link.
    for (const row of rows) {
      const link = row.querySelector<HTMLAnchorElement>('.row-link');
      if (!link) continue;
      row.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) return;
        link.click();
      });
    }
  }
</script>
