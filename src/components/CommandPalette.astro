---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { getCases } from '../lib/projects';
import { getCompanies } from '../lib/experience';
import { buildPaletteItems, searchText } from '../lib/palette';
import { getI18n } from '../i18n/ui';

interface Props {
  /** Same page in the other language. */
  alternate: string;
}

const { lang, ui } = getI18n(Astro.url);
const { alternate } = Astro.props;
const [cases, companies] = await Promise.all([getCases(lang), getCompanies(lang)]);
const items = buildPaletteItems({ lang, cases, companies, alternate });
---

<dialog
  class="palette"
  data-palette
  data-email={profile.email}
  data-results={JSON.stringify(ui.results)}
  data-copied={ui.paletteCopied}
  aria-label={ui.searchOrNavigate}
>
  <div class="palette__search">
    <Icon name="search" size={18} />
    <input
      type="text"
      placeholder={ui.palettePlaceholder}
      aria-label={ui.paletteSearch}
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      autocomplete="off"
      spellcheck="false"
      data-palette-input
    />
    <kbd class="mono">esc</kbd>
  </div>
  <ul class="palette__list" id="palette-list" role="listbox" data-palette-list>
    {
      items.map((item, index) => (
        <li
          role="option"
          id={`palette-opt-${index}`}
          aria-selected="false"
          data-label={searchText(item)}
          data-href={item.href}
          data-action={item.action}
        >
          <span class="palette__group mono">{item.group}</span>
          <span class="palette__label">{item.label}</span>
          {item.hint && (
            <span class="palette__hint mono" data-hint>
              {item.hint}
            </span>
          )}
        </li>
      ))
    }
  </ul>
  <p class="palette__empty mono" data-palette-empty hidden>{ui.paletteEmpty}</p>
</dialog>
<!-- Outside the dialog, so announcements survive it closing -->
<p class="sr-only" aria-live="polite" data-palette-status></p>

<style>
  .palette {
    width: min(640px, calc(100vw - 32px));
    max-height: min(520px, calc(100vh - 96px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 24px 64px var(--shadow);
    overflow: hidden;
    flex-direction: column;
  }

  .palette[open] {
    display: flex;
  }

  .palette::backdrop {
    background: var(--backdrop);
    backdrop-filter: blur(2px);
  }

  .palette__search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 18px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .palette__search input {
    flex: 1;
    min-height: 56px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    outline: none;
  }

  kbd {
    font-size: 11px;
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .palette__list {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
  }

  .palette__list li {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
  }

  .palette__list li[hidden] {
    display: none;
  }

  .palette__list li[aria-selected='true'] {
    background: var(--paper);
    box-shadow: inset 3px 0 0 var(--mag);
  }

  .palette__group,
  .palette__hint {
    font-size: 11px;
    color: var(--muted);
  }

  .palette__hint--select {
    user-select: all;
    color: var(--ink);
  }

  .palette__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette__empty {
    padding: 24px;
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 560px) {
    .palette__list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
    .palette__hint {
      display: none;
    }
  }
</style>

<script>
  import { toggleTheme } from '../lib/theme';
  import { formatCount, matchesQuery, readPlural, wrapIndex } from '../lib/filters';

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const options = [...dialog.querySelectorAll<HTMLLIElement>('[role="option"]')];
  const emptyMessage = dialog.querySelector<HTMLElement>('[data-palette-empty]')!;
  const status = document.querySelector<HTMLElement>('[data-palette-status]')!;
  const resultsLabel = readPlural(dialog.dataset.results);
  const email = dialog.dataset.email ?? '';
  let activeIndex = 0;

  const visibleOptions = () => options.filter((option) => !option.hidden);

  function highlight(index: number) {
    const visible = visibleOptions();
    if (!visible.length) {
      input.removeAttribute('aria-activedescendant');
      return;
    }
    activeIndex = wrapIndex(index, visible.length);
    options.forEach((option) => option.setAttribute('aria-selected', 'false'));
    const active = visible[activeIndex];
    active.setAttribute('aria-selected', 'true');
    input.setAttribute('aria-activedescendant', active.id);
    active.scrollIntoView({ block: 'nearest' });
  }

  function filter() {
    for (const option of options) option.hidden = !matchesQuery(option.dataset.label ?? '', input.value);
    const count = visibleOptions().length;
    emptyMessage.hidden = count > 0;
    status.textContent = formatCount(resultsLabel, count);
    highlight(0);
  }

  function open() {
    input.value = '';
    filter();
    dialog.showModal();
    input.focus();
  }

  async function copyEmail(option: HTMLLIElement) {
    const hint = option.querySelector<HTMLElement>('[data-hint]');
    try {
      await navigator.clipboard.writeText(email);
      const copied = dialog.dataset.copied ?? '';
      status.textContent = copied;
      // Show the confirmation for a moment before closing.
      if (hint) hint.textContent = `✓ ${copied}`;
      setTimeout(() => {
        dialog.close();
        if (hint) hint.textContent = email;
      }, 900);
    } catch {
      // No clipboard access: keep the dialog open so the address can be copied by hand.
      hint?.classList.add('palette__hint--select');
    }
  }

  function run(option: HTMLLIElement) {
    const { href, action } = option.dataset;
    if (action === 'copy-email') {
      copyEmail(option);
      return;
    }
    dialog.close();
    if (action === 'theme') toggleTheme();
    if (!href) return;
    // Other sites open in a new tab; own sections and pages, in the same one.
    const external = /^https?:/.test(href) && new URL(href).host !== location.host;
    if (external) window.open(href, '_blank', 'noopener');
    else location.href = href;
  }

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog.open) dialog.close();
      else open();
    }
  });

  for (const button of document.querySelectorAll('[data-open-palette]')) button.addEventListener('click', open);

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      highlight(activeIndex + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      highlight(activeIndex - 1);
    } else if (event.key === 'Enter') {
      event.preventDefault();
      const active = visibleOptions()[activeIndex];
      if (active) run(active);
    }
  });

  for (const option of options) {
    option.addEventListener('click', () => run(option));
    option.addEventListener('mousemove', () => highlight(visibleOptions().indexOf(option)));
  }

  // Close when clicking outside the box.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
