---
import Icon from './Icon.astro';
import { nav, profile } from '../data/profile';
import { getCases } from '../lib/projects';
import { companyHref, getCompanies } from '../lib/experience';
import { href, langFromPath, locale, otherLang, section } from '../i18n';
import { useT } from '../i18n/ui';
import { N } from '../lib/filters';

interface Props {
  /** Same page in the other language. */
  alternate: string;
}

const lang = langFromPath(Astro.url.pathname);
const other = otherLang(lang);
const t = useT(lang);
const { alternate } = Astro.props;
const [cases, companies] = await Promise.all([getCases(lang), getCompanies(lang)]);

type Item = { group: string; label: string; href?: string; action?: string; hint?: string };

const items: Item[] = [
  ...nav.map((n) => ({
    group: t.groupSections,
    label: n.label[lang],
    href: n.page ? href(lang, { name: n.page }) : section(lang, n.id),
  })),
  ...cases.map((c) => ({
    group: t.groupCases,
    label: c.data.title,
    href: href(lang, { name: 'case', id: c.id }),
    hint: c.data.client,
  })),
  ...companies.map((c) => ({ group: t.groupExperience, label: c.data.company, href: companyHref(c, lang), hint: c.data.role })),
  { group: t.groupPages, label: t.allCasesPage, href: href(lang, { name: 'cases' }) },
  { group: t.groupPages, label: t.printableCv, href: href(lang, { name: 'cv' }) },
  { group: t.groupActions, label: t.otherLanguage, href: alternate, hint: `${locale[other].name} · English Spanish español inglés` },
  { group: t.groupActions, label: t.toggleTheme, action: 'theme' },
  { group: t.groupActions, label: t.copyEmail, action: 'copy-email', hint: profile.email },
  { group: t.groupActions, label: t.writeEmail, href: `mailto:${profile.email}` },
  { group: t.groupActions, label: t.openLinkedIn, href: profile.links.linkedin },
];
---

<dialog
  class="palette"
  data-palette
  data-email={profile.email}
  data-results={t.results(N)}
  data-copied={t.paletteCopied}
  aria-label={t.searchOrNavigate}
>
  <div class="palette__search">
    <Icon name="search" size={18} />
    <input
      type="text"
      placeholder={t.palettePlaceholder}
      aria-label={t.paletteSearch}
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      autocomplete="off"
      spellcheck="false"
      data-palette-input
    />
    <kbd class="mono">esc</kbd>
  </div>
  <ul class="palette__list" id="palette-list" role="listbox" data-palette-list>
    {
      items.map((it, i) => (
        <li
          role="option"
          id={`palette-opt-${i}`}
          aria-selected="false"
          data-label={`${it.label} ${it.hint ?? ''} ${it.group}`.toLowerCase()}
          data-href={it.href}
          data-action={it.action}
        >
          <span class="palette__group mono">{it.group}</span>
          <span class="palette__label">{it.label}</span>
          {it.hint && <span class="palette__hint mono">{it.hint}</span>}
        </li>
      ))
    }
  </ul>
  <p class="palette__empty mono" data-palette-empty hidden>{t.paletteEmpty}</p>
  <p class="palette__status sr-only" aria-live="polite" data-palette-status></p>
</dialog>

<style>
  .palette {
    width: min(640px, calc(100vw - 32px));
    max-height: min(520px, calc(100vh - 96px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    flex-direction: column;
  }

  .palette[open] {
    display: flex;
  }

  .palette::backdrop {
    background: rgba(15, 15, 14, 0.45);
    backdrop-filter: blur(2px);
  }

  .palette__search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 18px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .palette__search input {
    flex: 1;
    min-height: 56px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    outline: none;
  }

  kbd {
    font-size: 11px;
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .palette__list {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
  }

  .palette__list li {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
  }

  .palette__list li[hidden] {
    display: none;
  }

  .palette__list li[aria-selected='true'] {
    background: var(--paper);
    box-shadow: inset 3px 0 0 var(--mag);
  }

  .palette__group,
  .palette__hint {
    font-size: 11px;
    color: var(--muted);
  }

  .palette__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette__empty {
    padding: 24px;
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 560px) {
    .palette__list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
    .palette__hint {
      display: none;
    }
  }
</style>

<script>
  import { toggleTheme } from '../lib/theme';
  import { fill, matchesQuery, wrapIndex } from '../lib/filters';

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const options = [...dialog.querySelectorAll<HTMLLIElement>('[role="option"]')];
  const empty = dialog.querySelector<HTMLElement>('[data-palette-empty]')!;
  const status = dialog.querySelector<HTMLElement>('[data-palette-status]')!;
  const email = dialog.dataset.email ?? '';
  let active = 0;

  const visible = () => options.filter((o) => !o.hidden);

  function highlight(index: number) {
    const list = visible();
    if (!list.length) return;
    active = wrapIndex(index, list.length);
    options.forEach((o) => o.setAttribute('aria-selected', 'false'));
    const current = list[active];
    current.setAttribute('aria-selected', 'true');
    input.setAttribute('aria-activedescendant', current.id);
    current.scrollIntoView({ block: 'nearest' });
  }

  function filter() {
    for (const o of options) o.hidden = !matchesQuery(o.dataset.label ?? '', input.value);
    const count = visible().length;
    empty.hidden = count > 0;
    status.textContent = fill(dialog.dataset.results ?? '', count);
    highlight(0);
  }

  function open() {
    input.value = '';
    filter();
    dialog.showModal();
    input.focus();
  }

  async function run(option: HTMLLIElement) {
    const { href, action } = option.dataset;
    if (href) {
      dialog.close();
      // Other sites open in a new tab; own sections and pages, in the same one.
      const external = /^https?:/.test(href) && new URL(href).host !== location.host;
      if (external) window.open(href, '_blank', 'noopener');
      else location.href = href;
      return;
    }
    if (action === 'theme') toggleTheme();
    if (action === 'copy-email') {
      try {
        await navigator.clipboard.writeText(email);
        status.textContent = dialog.dataset.copied ?? '';
      } catch {
        status.textContent = email;
      }
    }
    dialog.close();
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });

  for (const btn of document.querySelectorAll('[data-open-palette]')) btn.addEventListener('click', open);

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      highlight(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlight(active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const current = visible()[active];
      if (current) run(current);
    }
  });

  for (const o of options) {
    o.addEventListener('click', () => run(o));
    o.addEventListener('mousemove', () => highlight(visible().indexOf(o)));
  }

  // Close when clicking outside the box.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
