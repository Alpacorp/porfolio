---
import { getI18n } from '../i18n/ui';
import { navLinks } from '../lib/nav';

interface Props {
  /** On the home page links are anchors; elsewhere they point back to the home page. */
  home?: boolean;
}

const { lang, ui } = getI18n(Astro.url);
const { home = false } = Astro.props;
---

<!-- Sticky section bar for small screens, where the sidebar menu is hidden -->
<nav class="mnav no-print" aria-label={ui.sections}>
  <ul class="mnav__list" data-mnav>
    {
      navLinks(lang, Astro.url.pathname, home).map((link) => (
        <li>
          <a
            class="mnav__link mono"
            href={link.href}
            data-nav={link.section}
            aria-current={link.current ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .mnav {
    position: sticky;
    top: 0;
    z-index: 20;
    margin: 0 calc(var(--gutter) * -1);
    padding: 8px var(--gutter);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 1024px) {
    .mnav {
      display: none;
    }
  }

  .mnav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }

  .mnav__list::-webkit-scrollbar {
    display: none;
  }

  .mnav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 12px;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    color: var(--muted);
  }

  .mnav__link[aria-current] {
    background: var(--yellow);
    color: var(--on-yellow);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .mnav__list {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import { centerScrollLeft } from '../lib/geometry';

  // Keep the active section visible in the horizontal bar without scrolling the page.
  const list = document.querySelector<HTMLElement>('[data-mnav]');
  document.addEventListener('nav:active', (event) => {
    const link = (event as CustomEvent<HTMLAnchorElement>).detail;
    if (!list || !list.contains(link)) return;
    const left = centerScrollLeft(list.scrollLeft, list.getBoundingClientRect(), link.getBoundingClientRect());
    list.scrollTo({ left });
  });
</script>
