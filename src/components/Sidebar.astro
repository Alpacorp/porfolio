---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import avatar from '../assets/profile/avatar.webp';
import { profile } from '../data/profile';
import { href } from '../i18n';
import { getI18n } from '../i18n/ui';
import { navLinks } from '../lib/nav';

interface Props {
  /** On the home page links are anchors; elsewhere they point back to the home page. */
  home?: boolean;
  /** Same page in the other language. */
  alternate?: string;
}

const { lang, otherLang, ui } = getI18n(Astro.url);
const { home = false, alternate = href(otherLang, { name: 'home' }) } = Astro.props;
const NameTag = home ? 'h1' : 'p';
const tagline = profile.tagline[lang];
---

<aside class="sidebar">
  <div class="sidebar__top">
    <!-- Its accessible name is the visible brand plus «, inicio» for screen readers -->
    <a class="logo" href={href(lang, { name: 'home' })}>
      <span class="logo__mark" aria-hidden="true">A</span>
      <span class="logo__word mono">{profile.brand}</span><span class="sr-only">, {ui.home.toLowerCase()}</span>
    </a>
    <div class="sidebar__tools no-print">
      <button class="search-btn mono" type="button" data-open-palette aria-label={`${ui.searchOrNavigate} (⌘K)`}>
        <Icon name="search" size={16} />
        <kbd>⌘K</kbd>
      </button>
      <LangSwitch href={alternate} />
      <ThemeToggle />
    </div>
  </div>

  <div class="intro">
    <div class="intro__id">
      <Image
        class="intro__photo"
        src={avatar}
        width={72}
        height={72}
        densities={[1, 2, 3]}
        alt={ui.photoAlt(profile.name)}
        loading="eager"
      />
      <NameTag class="intro__name">Alejandro<br /><span class="intro__surname">Palacios Arévalo</span></NameTag>
    </div>
    <p class="intro__role mono">
      <span class="intro__now">{ui.roleAt(profile.role, profile.current)}</span>
      {profile.focus[lang]} · {profile.city}
    </p>
    <p class="intro__tagline">
      {tagline.before}<span class="hl">{tagline.highlight}</span>{tagline.after}
    </p>
  </div>

  <p class="status mono"><span class="status__dot" aria-hidden="true"></span>{profile.availability[lang]}</p>

  <nav class="nav no-print" aria-label={ui.sections}>
    {
      navLinks(lang, Astro.url.pathname, home).map((link) => (
        <a
          class="nav__link mono"
          href={link.href}
          data-nav={link.section}
          aria-current={link.current ? 'page' : undefined}
        >
          <span class="nav__bar" aria-hidden="true" />
          <span class="nav__label">{link.label}</span>
        </a>
      ))
    }
  </nav>

  <div class="social no-print">
    <a class="icon-btn" href={profile.links.linkedin} aria-label={`LinkedIn ${ui.opensNewTab}`} rel="me noopener" target="_blank"><Icon name="linkedin" /></a>
    <a class="icon-btn" href={profile.links.github} aria-label={`GitHub ${ui.opensNewTab}`} rel="me noopener" target="_blank"><Icon name="github" /></a>
    <a class="icon-btn" href={`mailto:${profile.email}`} aria-label={ui.email}><Icon name="mail" /></a>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (min-width: 1024px) {
    .sidebar {
      position: sticky;
      top: 56px;
      align-self: flex-start;
      width: 340px;
      flex-shrink: 0;
      max-height: calc(100vh - 80px);
      overflow-y: auto;
      scrollbar-width: none;
    }
  }

  .sidebar__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-size: 15px;
    min-height: 44px;
  }

  .logo__mark {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--yellow);
    color: var(--on-yellow);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 20px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Photo beside the name: same height as its two lines, so the sidebar doesn't grow */
  .intro__id {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .intro__photo {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 14px;
    object-fit: cover;
    border: 1.5px solid var(--line);
    transition: border-color 0.2s;
  }

  .intro__id:hover .intro__photo {
    border-color: var(--yellow);
  }

  .intro__name {
    font-size: clamp(28px, 8vw, 34px);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  /* Both surnames stay on one line */
  .intro__surname {
    white-space: nowrap;
  }

  .intro__role {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }

  .intro__now {
    color: var(--ink);
  }

  .intro__tagline {
    margin-top: 6px;
    font-size: 18px;
    line-height: 1.5;
  }

  .status {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 12px;
    color: var(--muted);
  }

  .status__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--yellow) 25%, transparent);
  }

  .nav {
    display: none;
    flex-direction: column;
    gap: 2px;
  }

  @media (min-width: 1024px) {
    .nav {
      display: flex;
    }
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 31px;
    font-size: 13px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  .nav__bar {
    display: block;
    width: 28px;
    height: 1px;
    background: currentColor;
    transition: width 0.2s, height 0.2s, background-color 0.2s;
  }

  .nav__label {
    padding: 0 3px;
    margin: 0 -3px;
    transition: background-size 0.2s;
    background: linear-gradient(var(--hl), var(--hl)) left 88% / 0 42% no-repeat;
  }

  /* Hover: magenta, the site's interaction color */
  .nav__link:hover {
    color: var(--ink);
  }

  .nav__link:hover .nav__bar {
    width: 56px;
    background: var(--mag);
  }

  /* Section on screen: the highlighter yellow, on the bar and under the text */
  .nav__link[aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  .nav__link[aria-current] .nav__bar {
    width: 56px;
    height: 3px;
    background: var(--yellow);
  }

  .nav__link[aria-current] .nav__label {
    background-size: 100% 42%;
  }

  .sidebar__tools {
    display: flex;
    gap: 8px;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
  }


  .search-btn:hover {
    border-color: var(--mag);
    color: var(--ink);
  }

  /* Touch screens have no keyboard shortcut: the magnifier is enough */
  @media (hover: none) {
    .search-btn kbd {
      display: none;
    }
  }

  kbd {
    font-family: var(--font-mono);
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--ink);
  }

  .social {
    display: flex;
    gap: 8px;
  }

  /* Short laptop screens: everything must fit without scrolling the sidebar */
  @media (min-width: 1024px) and (max-height: 900px) {
    .sidebar {
      top: 28px;
      max-height: calc(100vh - 40px);
      gap: 18px;
    }
    .intro {
      gap: 10px;
    }
    .intro__name {
      font-size: 32px;
    }
    .intro__tagline {
      font-size: 16px;
      margin-top: 2px;
    }
    .nav__link {
      min-height: 28px;
    }
  }

  /* Touch laptops: full-size targets (the compact list is for mouse and trackpad) */
  @media (pointer: coarse) {
    .nav__link {
      min-height: 44px;
    }
  }

  /* Narrow phones: the shortcut hint goes first, then the wordmark (the «A» stays) */
  @media (max-width: 420px) {
    .search-btn kbd {
      display: none;
    }
  }

  @media (max-width: 359px) {
    /* Hidden from sight only: it still names the home link */
    .logo__word {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .intro__surname {
      white-space: normal;
    }
  }
</style>

<script>
  // Highlight the section on screen in every menu that links to it (sidebar and mobile bar).
  const linksBySection = new Map<string, HTMLAnchorElement[]>();
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-nav]')) {
    const sectionId = link.dataset.nav!;
    linksBySection.set(sectionId, [...(linksBySection.get(sectionId) ?? []), link]);
  }
  const sections = [...linksBySection.keys()]
    .map((sectionId) => document.getElementById(sectionId))
    .filter((section): section is HTMLElement => section !== null);

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const links of linksBySection.values()) {
            links.forEach((link) => link.removeAttribute('aria-current'));
          }
          for (const link of linksBySection.get(entry.target.id) ?? []) {
            link.setAttribute('aria-current', 'true');
            document.dispatchEvent(new CustomEvent('nav:active', { detail: link }));
          }
        }
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
