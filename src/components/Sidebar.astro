---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import avatar from '../assets/profile/avatar.webp';
import { nav, profile } from '../data/profile';
import { href, langFromPath, otherLang, section } from '../i18n';
import { useT } from '../i18n/ui';

interface Props {
  /** On the home page links are anchors; elsewhere they point back to the home page. */
  home?: boolean;
  /** Same page in the other language. */
  alternate?: string;
}

const lang = langFromPath(Astro.url.pathname);
const other = otherLang(lang);
const t = useT(lang);
const { home = false, alternate = href(other, { name: 'home' }) } = Astro.props;
const NameTag = home ? 'h1' : 'p';
const tagline = profile.tagline[lang];
---

<aside class="sidebar">
  <div class="sidebar__top">
    <a class="logo" href={href(lang, { name: 'home' })} aria-label={t.homeAria(profile.site)}>
      <span class="logo__mark" aria-hidden="true">A</span>
      <span class="mono">alpacorp</span>
    </a>
    <div class="sidebar__tools no-print">
      <button class="search-btn mono" type="button" data-open-palette aria-label={`${t.searchOrNavigate} (⌘K)`}>
        <Icon name="search" size={16} />
        <kbd>⌘K</kbd>
      </button>
      <a class="icon-btn lang-btn mono" href={alternate} hreflang={other} lang={other} aria-label={t.switchLanguage} title={t.switchLanguage}>
        {other.toUpperCase()}
      </a>
      <ThemeToggle />
    </div>
  </div>

  <div class="intro">
    <div class="intro__id">
      <img
        class="intro__photo"
        src={avatar.src}
        width="72"
        height="72"
        alt={t.photoAlt(profile.name)}
        decoding="async"
      />
      <NameTag class="intro__name">Alejandro<br /><span class="intro__surname">Palacios Arévalo</span></NameTag>
    </div>
    <p class="intro__role mono">
      <span class="intro__now">{t.roleAt(profile.role, profile.current)}</span>
      {profile.focus[lang]} · {profile.city}
    </p>
    <p class="intro__tagline">
      {tagline.before}<span class="hl">{tagline.highlight}</span>{tagline.after}
    </p>
  </div>

  <p class="status mono"><span class="status__dot" aria-hidden="true"></span>{profile.availability[lang]}</p>

  <nav class="nav no-print" aria-label={t.sections}>
    {
      nav.map((item) => {
        const page = item.page && href(lang, { name: item.page });
        return (
        <a class="nav__link mono" href={page ?? (home ? `#${item.id}` : section(lang, item.id))}
          data-nav={page ? undefined : item.id}
          aria-current={page && Astro.url.pathname.startsWith(page) ? 'page' : undefined}
        >
          <span class="nav__bar" aria-hidden="true" />
          <span class="nav__label">{item.label[lang]}</span>
        </a>
        );
      })
    }
  </nav>

  <div class="social no-print">
    <a class="icon-btn" href={profile.links.linkedin} aria-label={`LinkedIn ${t.opensNewTab}`} rel="me noopener" target="_blank"><Icon name="linkedin" /></a>
    <a class="icon-btn" href={profile.links.github} aria-label={`GitHub ${t.opensNewTab}`} rel="me noopener" target="_blank"><Icon name="github" /></a>
    <a class="icon-btn" href={`mailto:${profile.email}`} aria-label={t.email}><Icon name="mail" /></a>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (min-width: 1024px) {
    .sidebar {
      position: sticky;
      top: 56px;
      align-self: flex-start;
      width: 340px;
      flex-shrink: 0;
      max-height: calc(100vh - 80px);
      overflow-y: auto;
      scrollbar-width: none;
    }
  }

  .sidebar__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-size: 15px;
    min-height: 44px;
  }

  .logo__mark {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--yellow);
    color: var(--on-yellow);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 20px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Photo beside the name: same height as its two lines, so the sidebar doesn't grow */
  .intro__id {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .intro__photo {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 14px;
    object-fit: cover;
    border: 1.5px solid var(--line);
    transition: border-color 0.2s;
  }

  .intro__id:hover .intro__photo {
    border-color: var(--yellow);
  }

  .intro__name {
    font-size: clamp(28px, 8vw, 34px);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  /* Both surnames stay on one line */
  .intro__surname {
    white-space: nowrap;
  }

  .intro__role {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }

  .intro__now {
    color: var(--ink);
  }

  .intro__tagline {
    margin-top: 6px;
    font-size: 18px;
    line-height: 1.5;
  }

  .status {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 12px;
    color: var(--muted);
  }

  .status__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 3px rgba(255, 221, 0, 0.25);
  }

  .nav {
    display: none;
    flex-direction: column;
    gap: 2px;
  }

  @media (min-width: 1024px) {
    .nav {
      display: flex;
    }
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 31px;
    font-size: 13px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  .nav__bar {
    display: block;
    width: 28px;
    height: 1px;
    background: currentColor;
    transition: width 0.2s, height 0.2s, background-color 0.2s;
  }

  .nav__label {
    padding: 0 3px;
    margin: 0 -3px;
    transition: background-size 0.2s;
    background: linear-gradient(var(--hl), var(--hl)) left 88% / 0 42% no-repeat;
  }

  /* Hover: magenta, el color de interacción del sitio */
  .nav__link:hover {
    color: var(--ink);
  }

  .nav__link:hover .nav__bar {
    width: 56px;
    background: var(--mag);
  }

  /* Sección en pantalla: el amarillo del resaltador, en la raya y bajo el texto */
  .nav__link[aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  .nav__link[aria-current] .nav__bar {
    width: 56px;
    height: 3px;
    background: var(--yellow);
  }

  .nav__link[aria-current] .nav__label {
    background-size: 100% 42%;
  }

  .sidebar__tools {
    display: flex;
    gap: 8px;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
  }

  .lang-btn {
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }

  .search-btn:hover {
    border-color: var(--mag);
    color: var(--ink);
  }

  /* Touch screens have no keyboard shortcut: the magnifier is enough */
  @media (hover: none) {
    .search-btn kbd {
      display: none;
    }
  }

  kbd {
    font-family: var(--font-mono);
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--ink);
  }

  .social {
    display: flex;
    gap: 8px;
  }

  /* Portátiles con poca altura: todo debe caber sin desplazar la barra lateral */
  @media (min-width: 1024px) and (max-height: 900px) {
    .sidebar {
      top: 28px;
      max-height: calc(100vh - 40px);
      gap: 18px;
    }
    .intro {
      gap: 10px;
    }
    .intro__name {
      font-size: 32px;
    }
    .intro__tagline {
      font-size: 16px;
      margin-top: 2px;
    }
    .nav__link {
      min-height: 28px;
    }
  }
</style>

<script>
  // Highlight the section on screen in every menu that links to it (sidebar and mobile bar).
  const links = new Map<string, HTMLAnchorElement[]>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-nav]')) {
    links.set(a.dataset.nav!, [...(links.get(a.dataset.nav!) ?? []), a]);
  }
  const sections = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const group of links.values()) group.forEach((a) => a.removeAttribute('aria-current'));
          for (const a of links.get(entry.target.id) ?? []) {
            a.setAttribute('aria-current', 'true');
            document.dispatchEvent(new CustomEvent('nav:active', { detail: a }));
          }
        }
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
