---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, profile } from '../data/profile';

interface Props {
  /** En la home los enlaces son anclas; en otras páginas apuntan a la home. */
  home?: boolean;
}

const { home = false } = Astro.props;
const base = home ? '' : '/';
const NameTag = home ? 'h1' : 'p';
---

<aside class="sidebar">
  <div class="sidebar__top">
    <a class="logo" href="/" aria-label={`${profile.site}, inicio`}>
      <span class="logo__mark" aria-hidden="true">a</span>
      <span class="mono">alpacorp</span>
    </a>
    <div class="sidebar__tools no-print">
      <button class="search-btn mono" type="button" data-open-palette aria-label="Buscar o navegar (⌘K)">
        <Icon name="search" size={16} />
        <kbd>⌘K</kbd>
      </button>
      <ThemeToggle />
    </div>
  </div>

  <div class="intro">
    <NameTag class="intro__name">Alejandro<br /><span class="intro__surname">Palacios Arévalo</span></NameTag>
    <p class="intro__role mono">
      <span class="intro__now">{profile.role} en {profile.current}</span>
      {profile.focus} · Bogotá
    </p>
    <p class="intro__tagline">
      Construyo producto digital con <span class="hl">ojo de negocio</span>: plataformas en Mercado
      Pago, banca digital y, como freelance, más de 30 proyectos para clientes en Colombia, México y
      EE. UU.
    </p>
  </div>

  <p class="status mono"><span class="status__dot" aria-hidden="true"></span>{profile.availability}</p>

  <nav class="nav no-print" aria-label="Secciones">
    {
      nav.map((item) => (
        <a class="nav__link mono" href={`${base}#${item.id}`} data-nav={item.id}>
          <span class="nav__bar" aria-hidden="true" />
          <span class="nav__label">{item.label}</span>
        </a>
      ))
    }
  </nav>

  <div class="social no-print">
    <a class="icon-btn" href={profile.links.linkedin} aria-label="LinkedIn (abre en otra pestaña)" rel="me noopener" target="_blank"><Icon name="linkedin" /></a>
    <a class="icon-btn" href={profile.links.github} aria-label="GitHub (abre en otra pestaña)" rel="me noopener" target="_blank"><Icon name="github" /></a>
    <a class="icon-btn" href={`mailto:${profile.email}`} aria-label="Correo"><Icon name="mail" /></a>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (min-width: 1024px) {
    .sidebar {
      position: sticky;
      top: 56px;
      align-self: flex-start;
      width: 340px;
      flex-shrink: 0;
      max-height: calc(100vh - 80px);
      overflow-y: auto;
      scrollbar-width: none;
    }
  }

  .sidebar__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-size: 15px;
    min-height: 44px;
  }

  .logo__mark {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--yellow);
    color: var(--on-yellow);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 20px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .intro__name {
    font-size: clamp(32px, 9vw, 40px);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  /* Both surnames stay on one line */
  .intro__surname {
    white-space: nowrap;
  }

  .intro__role {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }

  .intro__now {
    color: var(--ink);
  }

  .intro__tagline {
    margin-top: 6px;
    font-size: 18px;
    line-height: 1.5;
  }

  .status {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 12px;
    color: var(--muted);
  }

  .status__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 3px rgba(255, 221, 0, 0.25);
  }

  .nav {
    display: none;
    flex-direction: column;
    gap: 2px;
  }

  @media (min-width: 1024px) {
    .nav {
      display: flex;
    }
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 31px;
    font-size: 13px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  .nav__bar {
    display: block;
    width: 28px;
    height: 1px;
    background: currentColor;
    transition: width 0.2s, height 0.2s, background-color 0.2s;
  }

  .nav__label {
    padding: 0 3px;
    margin: 0 -3px;
    transition: background-size 0.2s;
    background: linear-gradient(var(--hl), var(--hl)) left 88% / 0 42% no-repeat;
  }

  /* Hover: magenta, el color de interacción del sitio */
  .nav__link:hover {
    color: var(--ink);
  }

  .nav__link:hover .nav__bar {
    width: 56px;
    background: var(--mag);
  }

  /* Sección en pantalla: el amarillo del resaltador, en la raya y bajo el texto */
  .nav__link[aria-current='true'] {
    color: var(--ink);
    font-weight: 600;
  }

  .nav__link[aria-current='true'] .nav__bar {
    width: 56px;
    height: 3px;
    background: var(--yellow);
  }

  .nav__link[aria-current='true'] .nav__label {
    background-size: 100% 42%;
  }

  .sidebar__tools {
    display: flex;
    gap: 8px;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
  }

  .search-btn:hover {
    border-color: var(--mag);
    color: var(--ink);
  }

  /* En pantallas táctiles el atajo de teclado no aplica: basta la lupa */
  @media (hover: none) {
    .search-btn kbd {
      display: none;
    }
  }

  kbd {
    font-family: var(--font-mono);
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--ink);
  }

  .social {
    display: flex;
    gap: 8px;
  }

  /* Portátiles con poca altura: todo debe caber sin desplazar la barra lateral */
  @media (min-width: 1024px) and (max-height: 900px) {
    .sidebar {
      top: 28px;
      max-height: calc(100vh - 40px);
      gap: 18px;
    }
    .intro {
      gap: 10px;
    }
    .intro__name {
      font-size: 36px;
    }
    .intro__tagline {
      font-size: 16px;
      margin-top: 2px;
    }
    .nav__link {
      min-height: 28px;
    }
  }
</style>

<script>
  // Marca en la navegación la sección visible.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav!, a]),
  );
  const sections = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const a of links.values()) a.removeAttribute('aria-current');
          links.get(entry.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
