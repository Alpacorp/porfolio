---
/**
 * Company or client logo (decorative: the name always appears as text too).
 *
 * - At rest: monochrome in the text color, painted through a mask
 *   (<id>.mono.webp), so it works the same in light and dark.
 * - On hover of the enclosing `logo-host` element: the original in color
 *   (<id>.webp), light theme only. Rules in global.css.
 *
 * Both images are resized to twice the displayed height (sharp on retina, a
 * fraction of the original weight). Registry, sizes and sources: src/data/logos.ts.
 */
import { getImage } from 'astro:assets';
import { logos, type LogoId } from '../data/logos';

interface Props {
  id: LogoId;
  /** Multiplies the configured height (e.g. 0.8 in compact lists). */
  scale?: number;
  class?: string;
}

// Importing the image gives its URL and dimensions, so the space is reserved before it loads.
const files = import.meta.glob<ImageMetadata>('../assets/logos/*.webp', { eager: true, import: 'default' });
const findFile = (name: string) => files[`../assets/logos/${name}.webp`];

const { id, scale = 1, class: className } = Astro.props;
const config: { height: number; hoverColor?: boolean } = logos[id];
const height = Math.round(config.height * scale);
const isOwnBrand = id === 'alpacorp';
const showsColor = config.hoverColor !== false;

const colorFile = isOwnBrand ? undefined : findFile(id);
const monoFile = isOwnBrand ? undefined : findFile(`${id}.mono`);
if (!isOwnBrand && (!colorFile || !monoFile)) {
  throw new Error(`Missing logo files for «${id}» in src/assets/logos/`);
}
const width = colorFile ? Math.round((height * colorFile.width) / colorFile.height) : 0;
const resize = (file: ImageMetadata) => getImage({ src: file, height: height * 2, format: 'webp' });
const mono = monoFile && (await resize(monoFile));
// Logos whose original is white never show it, so it isn't downloaded at all.
const color = colorFile && showsColor ? await resize(colorFile) : undefined;
---

{
  isOwnBrand ? (
    <span class:list={['logo', 'logo--alpacorp', className]} style={`--h: ${height}px`} aria-hidden="true">
      <span class="logo__a">A</span>
      <span class="logo__word">alpacorp</span>
    </span>
  ) : (
    <span
      class:list={['logo', className, { 'logo--color': showsColor }]}
      style={`--h: ${height}px; width: ${width}px; --mono: url('${mono!.src}')`}
      aria-hidden="true"
    >
      {color && (
        <img class="logo__color" src={color.src} width={width} height={height} alt="" loading="lazy" decoding="async" />
      )}
      <span class="logo__mono" />
    </span>
  )
}

<style>
  .logo {
    position: relative;
    display: inline-block;
    height: var(--h);
    line-height: 0;
    flex-shrink: 0;
    vertical-align: middle;
    /* Inside grid/flex it must not stretch or centre: its width comes from the logo's ratio */
    justify-self: start;
    align-self: flex-start;
  }

  /* The color original fills the box set on .logo; invisible at rest */
  .logo__color {
    height: 100%;
    width: auto;
    max-width: none;
    display: block;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .logo__mono {
    position: absolute;
    inset: 0;
    background: currentColor;
    -webkit-mask: var(--mono) no-repeat left center / contain;
    mask: var(--mono) no-repeat left center / contain;
    transition: opacity 0.2s;
  }

  .logo--alpacorp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    line-height: 1;
  }

  .logo__a {
    display: grid;
    place-items: center;
    height: 100%;
    aspect-ratio: 1;
    border-radius: 5px;
    /* The own brand: the same yellow square as the site header */
    background: var(--yellow);
    color: var(--on-yellow);
    font-weight: 800;
    font-size: 15px;
  }

  .logo__word {
    font-family: var(--font-mono);
    font-size: 15px;
  }
</style>
