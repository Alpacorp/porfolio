---
import Icon from './Icon.astro';

/** «Back» link shown at the top of every inner page. */
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="back mono" href={href}><Icon name="arrow-left" size={16} /> {label}</a>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    min-height: 44px;
    font-size: 13px;
    text-decoration: none;
    color: var(--muted);
  }

  .back:hover {
    color: var(--ink);
  }
</style>
