---
import { freelanceGroups, freelanceSince, milestones, timelineRange } from '../../data/career';
import { groupItems, type Project } from '../../lib/projects';
import TimelinePanel from '../TimelinePanel.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const span = timelineRange.to - timelineRange.from;
const pos = (year: number) => `${(((year - timelineRange.from) / span) * 100).toFixed(2)}%`;
const initial = `y-${milestones.at(-1)!.year}`;
const current = milestones.find((m) => m.current);
---

<section id="trayectoria" class="section" aria-labelledby="trayectoria-titulo" data-timeline>
  <h2 id="trayectoria-titulo" class="eyebrow">02 — Trayectoria</h2>

  <!-- Carril 1: empleo. Los años controlan el panel que va justo debajo. -->
  <div class="lane" data-lane>
    <p class="lane-label mono muted">Empleo <span class="lane-hint">· toca un año</span></p>
    <div class="axis" role="group" aria-label="Hitos de empleo">
      <div class="axis__ticks" aria-hidden="true"></div>
      {current && (
        <div class="now-bar" style={`left: ${pos(current.year)}`} aria-hidden="true">
          <span class="now-bar__label mono">hoy</span>
        </div>
      )}
      {
        milestones.map((m) => {
          const id = `y-${m.year}`;
          return (
            <button
              class="year"
              type="button"
              style={`left: ${pos(m.year)}`}
              aria-pressed={id === initial ? 'true' : 'false'}
              aria-controls="panel-empleo"
              aria-label={`${m.year}: ${m.role}, ${m.org}`}
              data-target={id}
            >
              <span class="year__label mono">{m.year}</span>
              <span class="year__line" aria-hidden="true" />
            </button>
          );
        })
      }
    </div>
    <div id="panel-empleo" class="card panel" data-panel-box>
      {
        milestones.map((m) => (
          <TimelinePanel
            id={`y-${m.year}`}
            heading={m.current ? `${m.year} → hoy` : String(m.year)}
            current={m.current}
            logo={m.logo}
            more={m.more}
            role={m.role}
            org={m.org}
            text={m.text}
            hidden={`y-${m.year}` !== initial}
          />
        ))
      }
    </div>
  </div>

  <!-- Carril 2: freelance. Empieza cerrado; cada bloque abre o cierra su lista de proyectos. -->
  <div class="lane" data-lane data-collapsible>
    <p class="lane-label mono muted">
      Freelance · alpacorp, en paralelo <span class="lane-hint">· toca un bloque para ver sus proyectos</span>
    </p>
    <div class="axis axis--free" aria-hidden="true">
      <div class="free-bar mono" style={`left: ${pos(freelanceSince)}`}>{freelanceSince} → hoy</div>
    </div>
    <div class="groups" role="group" aria-label="Bloques freelance">
      {
        freelanceGroups.map((g) => (
          <button
            class="group"
            type="button"
            aria-expanded="false"
            aria-controls="panel-freelance"
            data-target={`g-${g.id}`}
          >
            <span class="group__label">{g.label}</span>
            <span class="group__sub mono">{g.sub}</span>
            <span class="group__cta mono" aria-hidden="true">
              <span class="group__open">Ver proyectos ↓</span>
              <span class="group__close">Cerrar ↑</span>
            </span>
          </button>
        ))
      }
    </div>
    <div id="panel-freelance" class="card panel" data-panel-box hidden>
      {
        freelanceGroups.map((g) => (
          <TimelinePanel
            id={`g-${g.id}`}
            heading={g.label}
            role={g.role}
            org={g.org}
            text={g.text}
            items={groupItems(projects, g.id)}
            more={g.more}
            hidden
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .lane {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lane-label {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lane-hint {
    text-transform: none;
    letter-spacing: 0;
  }

  .axis {
    position: relative;
    height: 96px;
    margin: 0 24px;
  }

  .axis__ticks {
    position: absolute;
    left: -24px;
    right: -24px;
    top: 30px;
    height: 12px;
    border-bottom: 1px solid var(--line);
    background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 12px);
  }

  /* Franja desde el empleo actual hasta el final del eje: «sigo aquí». */
  .now-bar {
    position: absolute;
    right: -24px;
    top: 38px;
    height: 4px;
    border-radius: 2px;
    background: var(--yellow);
  }

  .now-bar__label {
    position: absolute;
    right: 0;
    top: 10px;
    font-size: 11px;
    font-weight: 500;
    color: var(--ink);
  }

  .year {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }

  .year__label {
    font-size: 13px;
  }

  .year__line {
    display: block;
    width: 2px;
    height: 18px;
    background: currentColor;
    transition: height 0.2s;
  }

  .year:hover {
    color: var(--mag);
  }

  .year[aria-pressed='true'] {
    color: var(--ink);
    font-weight: 700;
  }

  .year[aria-pressed='true'] .year__line {
    height: 40px;
    background: var(--yellow);
  }

  .axis--free {
    height: 26px;
  }

  .axis--free::before {
    content: '';
    position: absolute;
    left: -24px;
    right: -24px;
    top: 12px;
    height: 1px;
    background: var(--line);
  }

  .free-bar {
    position: absolute;
    right: -24px;
    top: 3px;
    height: 20px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--on-yellow);
    font-size: 11px;
    font-weight: 500;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
  }

  .group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-height: 64px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
  }

  .group:hover {
    border-color: var(--mag);
  }

  .group[aria-expanded='true'] {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--on-yellow);
  }

  .group__label {
    font-size: 15px;
    font-weight: 600;
  }

  .group__sub,
  .group__cta {
    font-size: 11px;
    opacity: 0.8;
  }

  .group__cta {
    margin-top: auto;
    padding-top: 6px;
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .group[aria-expanded='true'] .group__cta {
    text-decoration-color: currentColor;
  }

  .group__close,
  .group[aria-expanded='true'] .group__open {
    display: none;
  }

  .group[aria-expanded='true'] .group__close {
    display: inline;
  }

  /* Yellow border: the panel belongs to the year (or block) highlighted in yellow above */
  .panel {
    position: relative;
    padding: clamp(20px, 3vw, 30px);
    scroll-margin: 24px;
    border: 1.5px solid var(--yellow);
  }

  /* Pointer on the top border, aimed at the selected year or block (x set from the script) */
  .panel[data-pointer]::before {
    content: '';
    position: absolute;
    top: -9px;
    left: var(--pointer-x, 50%);
    width: 16px;
    height: 16px;
    background: var(--surface);
    border-top: 1.5px solid var(--yellow);
    border-left: 1.5px solid var(--yellow);
    border-top-left-radius: 3px;
    transform: translateX(-50%) rotate(45deg);
    transition: left 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .panel[data-pointer]::before {
      transition: none;
    }
  }

  .panel[hidden] {
    display: none;
  }

  /* En pantallas estrechas los años se encimarían: el eje pasa a ser una fila de botones. */
  @media (max-width: 640px) {
    .axis:not(.axis--free) {
      height: auto;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .axis__ticks,
    .year__line,
    .now-bar {
      display: none;
    }
    .year {
      position: static;
      transform: none;
      justify-content: center;
      gap: 0;
      padding: 0 14px;
      border: 1px solid var(--line);
      border-radius: 999px;
    }
    .year[aria-pressed='true'] {
      background: var(--yellow);
      border-color: var(--yellow);
      color: var(--on-yellow);
    }
    .axis--free {
      margin: 0 12px;
    }
    .axis--free::before {
      left: -12px;
      right: -12px;
    }
    .free-bar {
      right: -12px;
    }
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  /** Si el panel quedó fuera de la pantalla (típico en móvil), lo trae a la vista. */
  function reveal(box: HTMLElement) {
    const r = box.getBoundingClientRect();
    if (r.top < 0 || r.top > innerHeight * 0.6) {
      box.scrollIntoView({ block: 'start', behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    }
  }

  /** Aim the panel's pointer at the centre of the trigger that opened it. */
  function point(box: HTMLElement, trigger: HTMLElement) {
    const b = box.getBoundingClientRect();
    const t = trigger.getBoundingClientRect();
    const x = Math.min(Math.max(t.left + t.width / 2 - b.left, 24), b.width - 24);
    box.style.setProperty('--pointer-x', `${x}px`);
    box.dataset.pointer = '';
  }

  const pointers: (() => void)[] = [];
  // Fonts can shift the years slightly once loaded, so re-aim after load and on resize.
  for (const ev of ['load', 'resize']) addEventListener(ev, () => pointers.forEach((update) => update()));

  for (const lane of document.querySelectorAll<HTMLElement>('[data-timeline] [data-lane]')) {
    const triggers = [...lane.querySelectorAll<HTMLButtonElement>('[data-target]')];
    const box = lane.querySelector<HTMLElement>('[data-panel-box]')!;
    const panels = [...box.querySelectorAll<HTMLElement>('[data-panel]')];
    const collapsible = lane.hasAttribute('data-collapsible');
    // Los años son un selector (aria-pressed); los bloques freelance, un acordeón (aria-expanded).
    const state = collapsible ? 'aria-expanded' : 'aria-pressed';

    const update = () => {
      const active = triggers.find((t) => t.getAttribute(state) === 'true');
      if (active && !box.hidden) point(box, active);
    };
    pointers.push(update);
    update();

    for (const trigger of triggers) {
      trigger.addEventListener('click', () => {
        const closing = collapsible && trigger.getAttribute(state) === 'true';
        const target = closing ? null : trigger.dataset.target;

        for (const t of triggers) {
          t.setAttribute(state, String(t === trigger && !closing));
        }
        panels.forEach((p) => (p.hidden = p.dataset.panel !== target));
        box.hidden = target === null;

        if (target) {
          point(box, trigger);
          reveal(box);
        }
      });
    }
  }
</script>
