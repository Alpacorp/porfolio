---
import { freelanceGroups, freelanceSince, milestones, timelineRange, type More } from '../../data/career';
import { groupItems, type Project } from '../../lib/projects';
import { yearToPercent } from '../../lib/geometry';
import TimelinePanel from '../TimelinePanel.astro';
import { href } from '../../i18n';
import { getI18n } from '../../i18n/ui';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const { lang, ui } = getI18n(Astro.url);
const readMore = (more: More) => ({
  href: href(lang, more.route, more.suffix),
  label: more.label?.[lang] ?? ui.fullExperience,
});
const position = (year: number) => yearToPercent(year, timelineRange);
const initialPanel = `y-${milestones.at(-1)!.year}`;
const currentMilestone = milestones.find((milestone) => milestone.current);
---

<section id="trayectoria" class="section" aria-labelledby="trayectoria-titulo" data-timeline>
  <h2 id="trayectoria-titulo" class="eyebrow">{ui.timeline}</h2>

  <!-- Lane 1: employment. The years drive the panel right below. -->
  <div class="lane" data-lane>
    <p class="lane-label mono muted">{ui.employmentLane} <span class="lane-hint">{ui.employmentHint}</span></p>
    <div class="axis" role="group" aria-label={ui.employmentAria}>
      <div class="axis__ticks" aria-hidden="true"></div>
      {currentMilestone && (
        <div class="now-bar" style={`left: ${position(currentMilestone.year)}`} aria-hidden="true">
          <span class="now-bar__label mono">{ui.today}</span>
        </div>
      )}
      {
        milestones.map((milestone) => {
          const id = `y-${milestone.year}`;
          return (
            <button
              class="year"
              type="button"
              style={`left: ${position(milestone.year)}`}
              aria-pressed={id === initialPanel ? 'true' : 'false'}
              aria-controls="panel-empleo"
              aria-label={`${milestone.year}: ${milestone.role[lang]}, ${milestone.org}`}
              data-target={id}
            >
              <span class="year__label mono">{milestone.year}</span>
              <span class="year__line" aria-hidden="true" />
            </button>
          );
        })
      }
    </div>
    <div id="panel-empleo" class="card panel" data-panel-box>
      {
        milestones.map((milestone) => (
          <TimelinePanel
            id={`y-${milestone.year}`}
            heading={milestone.current ? `${milestone.year} → ${ui.today}` : String(milestone.year)}
            current={milestone.current}
            logo={milestone.logo}
            more={readMore(milestone.more)}
            role={milestone.role[lang]}
            org={milestone.org}
            text={milestone.text[lang]}
            hidden={`y-${milestone.year}` !== initialPanel}
          />
        ))
      }
    </div>
  </div>

  <!-- Lane 2: freelance. Starts closed; each block opens or closes its project list. -->
  <div class="lane" data-lane data-collapsible>
    <p class="lane-label mono muted">
      {ui.freelanceLane} <span class="lane-hint">{ui.freelanceHint}</span>
    </p>
    <div class="axis axis--free" aria-hidden="true">
      <div class="free-bar mono" style={`left: ${position(freelanceSince)}`}>{freelanceSince} → {ui.today}</div>
    </div>
    <div class="groups" role="group" aria-label={ui.freelanceAria}>
      {
        freelanceGroups.map((group) => (
          <button
            class="group"
            type="button"
            aria-expanded="false"
            aria-controls="panel-freelance"
            data-target={`g-${group.id}`}
          >
            <span class="group__label">{group.label[lang]}</span>
            <span class="group__sub mono">{group.sub[lang]}</span>
            <span class="group__cta mono" aria-hidden="true">
              <span class="group__open">{ui.seeProjects}</span>
              <span class="group__close">{ui.close}</span>
            </span>
          </button>
        ))
      }
    </div>
    <div id="panel-freelance" class="card panel" data-panel-box hidden>
      {
        freelanceGroups.map((group) => (
          <TimelinePanel
            id={`g-${group.id}`}
            heading={group.label[lang]}
            role={group.role[lang]}
            org={group.org[lang]}
            text={group.text[lang]}
            items={groupItems(projects, group.id, lang)}
            more={readMore(group.more)}
            hidden
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .lane {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lane-label {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lane-hint {
    text-transform: none;
    letter-spacing: 0;
  }

  .axis {
    position: relative;
    height: 96px;
    margin: 0 24px;
  }

  .axis__ticks {
    position: absolute;
    left: -24px;
    right: -24px;
    top: 30px;
    height: 12px;
    border-bottom: 1px solid var(--line);
    background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 12px);
  }

  /* Band from the current job to the end of the axis: «still here». */
  .now-bar {
    position: absolute;
    right: -24px;
    top: 38px;
    height: 4px;
    border-radius: 2px;
    background: var(--yellow);
  }

  .now-bar__label {
    position: absolute;
    right: 0;
    top: 10px;
    font-size: 11px;
    font-weight: 500;
    color: var(--ink);
  }

  .year {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }

  .year__label {
    font-size: 13px;
  }

  .year__line {
    display: block;
    width: 2px;
    height: 18px;
    background: currentColor;
    transition: height 0.2s;
  }

  .year:hover {
    color: var(--mag);
  }

  .year[aria-pressed='true'] {
    color: var(--ink);
    font-weight: 700;
  }

  .year[aria-pressed='true'] .year__line {
    height: 40px;
    background: var(--yellow);
  }

  .axis--free {
    height: 26px;
  }

  .axis--free::before {
    content: '';
    position: absolute;
    left: -24px;
    right: -24px;
    top: 12px;
    height: 1px;
    background: var(--line);
  }

  .free-bar {
    position: absolute;
    right: -24px;
    top: 3px;
    height: 20px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--on-yellow);
    font-size: 11px;
    font-weight: 500;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
  }

  .group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-height: 64px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
  }

  .group:hover {
    border-color: var(--mag);
  }

  .group[aria-expanded='true'] {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--on-yellow);
  }

  .group__label {
    font-size: 15px;
    font-weight: 600;
  }

  .group__sub,
  .group__cta {
    font-size: 11px;
    opacity: 0.8;
  }

  .group__cta {
    margin-top: auto;
    padding-top: 6px;
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .group[aria-expanded='true'] .group__cta {
    text-decoration-color: currentColor;
  }

  .group__close,
  .group[aria-expanded='true'] .group__open {
    display: none;
  }

  .group[aria-expanded='true'] .group__close {
    display: inline;
  }

  /* Yellow border: the panel belongs to the year (or block) highlighted in yellow above */
  .panel {
    position: relative;
    padding: clamp(20px, 3vw, 30px);
    scroll-margin: 24px;
    border: 1.5px solid var(--yellow);
  }

  /* Pointer on the top border, aimed at the selected year or block (x set from the script) */
  .panel[data-pointer]::before {
    content: '';
    position: absolute;
    top: -9px;
    left: var(--pointer-x, 50%);
    width: 16px;
    height: 16px;
    background: var(--surface);
    border-top: 1.5px solid var(--yellow);
    border-left: 1.5px solid var(--yellow);
    border-top-left-radius: 3px;
    transform: translateX(-50%) rotate(45deg);
    transition: left 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .panel[data-pointer]::before {
      transition: none;
    }
  }

  .panel[hidden] {
    display: none;
  }

  /* On narrow screens the years would overlap: the axis becomes a row of buttons. */
  @media (max-width: 640px) {
    .axis:not(.axis--free) {
      height: auto;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .axis__ticks,
    .year__line,
    .now-bar {
      display: none;
    }
    .year {
      position: static;
      transform: none;
      justify-content: center;
      gap: 0;
      padding: 0 14px;
      border: 1px solid var(--line);
      border-radius: 999px;
    }
    .year[aria-pressed='true'] {
      background: var(--yellow);
      border-color: var(--yellow);
      color: var(--on-yellow);
    }
    .axis--free {
      margin: 0 12px;
    }
    .axis--free::before {
      left: -12px;
      right: -12px;
    }
    .free-bar {
      right: -12px;
    }
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { pointerOffset } from '../../lib/geometry';

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  /** If the panel ended up off screen (typical on mobile), bring it into view. */
  function reveal(panelBox: HTMLElement) {
    const { top } = panelBox.getBoundingClientRect();
    if (top < 0 || top > innerHeight * 0.6) {
      panelBox.scrollIntoView({ block: 'start', behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    }
  }

  /** Aim the panel's pointer at the centre of the trigger that opened it. */
  function aimPointer(panelBox: HTMLElement, trigger: HTMLElement) {
    const offset = pointerOffset(trigger.getBoundingClientRect(), panelBox.getBoundingClientRect());
    panelBox.style.setProperty('--pointer-x', `${offset}px`);
    panelBox.dataset.pointer = '';
  }

  const pointerUpdates: (() => void)[] = [];
  let pendingFrame = 0;
  const updatePointers = () => {
    cancelAnimationFrame(pendingFrame);
    pendingFrame = requestAnimationFrame(() => pointerUpdates.forEach((update) => update()));
  };
  // Fonts can shift the years slightly once loaded, so re-aim after load and on resize.
  addEventListener('load', updatePointers);
  addEventListener('resize', updatePointers);

  for (const lane of document.querySelectorAll<HTMLElement>('[data-timeline] [data-lane]')) {
    const triggers = [...lane.querySelectorAll<HTMLButtonElement>('[data-target]')];
    const panelBox = lane.querySelector<HTMLElement>('[data-panel-box]')!;
    const panels = [...panelBox.querySelectorAll<HTMLElement>('[data-panel]')];
    const collapsible = lane.hasAttribute('data-collapsible');
    // Years are a selector (aria-pressed); freelance blocks, an accordion (aria-expanded).
    const stateAttribute = collapsible ? 'aria-expanded' : 'aria-pressed';

    const update = () => {
      const active = triggers.find((trigger) => trigger.getAttribute(stateAttribute) === 'true');
      if (active && !panelBox.hidden) aimPointer(panelBox, active);
    };
    pointerUpdates.push(update);
    update();

    for (const trigger of triggers) {
      trigger.addEventListener('click', () => {
        const closing = collapsible && trigger.getAttribute(stateAttribute) === 'true';
        const target = closing ? null : trigger.dataset.target;

        for (const other of triggers) {
          other.setAttribute(stateAttribute, String(other === trigger && !closing));
        }
        panels.forEach((panel) => (panel.hidden = panel.dataset.panel !== target));
        panelBox.hidden = target === null;

        if (target) {
          aimPointer(panelBox, trigger);
          reveal(panelBox);
        }
      });
    }
  }
</script>
