---
import { profile } from '../../data/profile';
import { href } from '../../i18n';
import { getI18n } from '../../i18n/ui';

const { lang, ui } = getI18n(Astro.url);
---

<section id="contacto" class="contact" aria-labelledby="contacto-titulo">
  <h2 id="contacto-titulo" class="eyebrow contact__eyebrow">{ui.contact}</h2>
  <p class="contact__title">{ui.contactTitle}</p>
  <p class="contact__text">{ui.contactText}</p>
  <div class="contact__actions">
    <a class="btn btn--dark" href={`mailto:${profile.email}`}>{ui.writeMe}</a>
    <a class="btn btn--outline" href={href(lang, { name: 'cv' })}>{ui.cvButton}</a>
  </div>
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: clamp(28px, 5vw, 52px);
    border-radius: 16px;
    background: var(--yellow);
    color: var(--on-yellow);
  }

  .contact__eyebrow {
    color: var(--on-yellow);
  }

  .contact__title {
    font-size: clamp(32px, 5vw, 46px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .contact__text {
    font-size: 17px;
    line-height: 1.5;
    max-width: 560px;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .contact :focus-visible {
    outline-color: var(--on-yellow);
  }
</style>
