---
import { profile } from '../../data/profile';
import { href, langFromPath } from '../../i18n';
import { useT } from '../../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
---

<section id="contacto" class="contact" aria-labelledby="contacto-titulo">
  <h2 id="contacto-titulo" class="eyebrow contact__eyebrow">{t.contact}</h2>
  <p class="contact__title">{t.contactTitle}</p>
  <p class="contact__text">{t.contactText}</p>
  <div class="contact__actions">
    <a class="btn btn--dark" href={`mailto:${profile.email}`}>{t.writeMe}</a>
    <a class="btn btn--outline" href={href(lang, { name: 'cv' })}>{t.cvButton}</a>
  </div>
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: clamp(28px, 5vw, 52px);
    border-radius: 16px;
    background: var(--yellow);
    color: var(--on-yellow);
  }

  .contact__eyebrow {
    color: var(--on-yellow);
  }

  .contact__title {
    font-size: clamp(32px, 5vw, 46px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .contact__text {
    font-size: 17px;
    line-height: 1.5;
    max-width: 560px;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .contact :focus-visible {
    outline-color: #151515;
  }
</style>
