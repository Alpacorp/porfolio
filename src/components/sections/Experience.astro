---
import Logo from '../Logo.astro';
import { experienceFilters } from '../../data/career';
import { getExperienceItems } from '../../lib/experience';
import { href } from '../../i18n';
import { getI18n } from '../../i18n/ui';

const { lang, ui } = getI18n(Astro.url);
// One row per company (plus freelance). The full story lives on each company page.
const items = await getExperienceItems(lang);
---

<section
  id="experiencia"
  class="section"
  aria-labelledby="experiencia-titulo"
  data-filterable
  data-results={JSON.stringify(ui.results)}
>
  <h2 id="experiencia-titulo" class="eyebrow">{ui.experience}</h2>

  <div class="filters" role="group" aria-label={ui.filterByFocus}>
    {
      experienceFilters.map((filter, index) => (
        <button class="chip" type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-filter={filter.key}>
          {filter.label[lang]}
        </button>
      ))
    }
  </div>

  <ol class="jobs">
    {
      items.map((job) => (
        <li class="job logo-host" data-tags={job.filters.join('|')}>
          <div class="job__side">
            <span class="job__logo"><Logo id={job.logo} /></span>
            <p class="mono muted job__dates">
              {job.dates}
              {job.current && <span class="pill-now">{ui.current}</span>}
            </p>
          </div>
          <div class="job__body">
            <h3 class="job__title">
              {job.role} <span class="muted">· {job.company}</span>
            </h3>
            <p class="muted job__text">{job.summary}</p>
            <ul class="job__highlights">
              {job.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <ul class="job__tags" aria-label={ui.technologies}>
              {job.stack.slice(0, 6).map((technology) => (
                <li class="tag">{technology}</li>
              ))}
            </ul>
            <a class="more-link" href={job.href}>
              {job.hrefLabel}{' '}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="sr-only" aria-live="polite" data-filter-status></p>

  <a class="mono cv-link" href={href(lang, { name: 'cv' })}>{ui.fullCv}</a>
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .job {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 32px;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }

  .job[hidden] {
    display: none;
  }

  .job__side {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Fixed-height slot: the dates line up across rows whatever the logo */
  .job__logo {
    height: 34px;
    display: flex;
    align-items: center;
  }

  .job__dates {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    font-size: 13px;
    line-height: 1.5;
  }

  .job__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .job__title {
    font-size: 19px;
    font-weight: 600;
  }

  .job__title .muted {
    font-weight: 400;
  }

  .job__text {
    font-size: 15px;
    line-height: 1.6;
  }

  .job__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 15px;
    line-height: 1.5;
  }

  /* Highlighter tick: the brand yellow marks each achievement */
  .job__highlights li {
    position: relative;
    padding-left: 18px;
  }

  .job__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 3px;
    border-radius: 2px;
    background: var(--yellow);
  }


  .job__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cv-link {
    align-self: flex-start;
    font-size: 14px;
  }

  @media (max-width: 640px) {
    .job {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .job__dates {
      flex-direction: row;
      align-items: center;
    }
    .job__side {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  import { formatCount, matchesTag, readPlural } from '../../lib/filters';

  const root = document.querySelector<HTMLElement>('[data-filterable]');
  if (root) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const jobs = [...root.querySelectorAll<HTMLElement>('[data-tags]')];
    const status = root.querySelector<HTMLElement>('[data-filter-status]')!;
    const resultsLabel = readPlural(root.dataset.results);

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter!;
        chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
        let shown = 0;
        for (const job of jobs) {
          job.hidden = !matchesTag(job.dataset.tags!.split('|'), filter);
          if (!job.hidden) shown++;
        }
        status.textContent = formatCount(resultsLabel, shown);
      });
    }
  }
</script>
