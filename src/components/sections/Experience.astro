---
import Logo from '../Logo.astro';
import { experienceFilters } from '../../data/career';
import { getExperienceItems } from '../../lib/experience';

// One row per company (plus freelance). The full story lives on each company page.
const items = await getExperienceItems();
---

<section id="experiencia" class="section" aria-labelledby="experiencia-titulo" data-filterable>
  <h2 id="experiencia-titulo" class="eyebrow">04 — Experiencia</h2>

  <div class="filters" role="group" aria-label="Filtrar por enfoque">
    {
      experienceFilters.map((f, i) => (
        <button class="chip" type="button" aria-pressed={i === 0 ? "true" : "false"} data-filter={f}>
          {f}
        </button>
      ))
    }
  </div>

  <ol class="jobs">
    {
      items.map((job) => (
        <li class="job logo-host" id={`exp-${job.id}`} data-tags={job.filters.join('|')}>
          <div class="job__side">
            <span class="job__logo"><Logo id={job.logo} /></span>
            <p class="mono muted job__dates">
              {job.dates}
              {job.current && <span class="now">Actual</span>}
            </p>
          </div>
          <div class="job__body">
            <h3 class="job__title">
              {job.role} <span class="muted">· {job.company}</span>
            </h3>
            <p class="muted job__text">{job.summary}</p>
            <ul class="job__highlights">
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <ul class="job__tags" aria-label="Tecnologías">
              {job.stack.slice(0, 6).map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
            <a class="job__more mono" href={job.href}>
              {job.hrefLabel}{' '}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="sr-only" aria-live="polite" data-filter-status></p>

  <a class="mono cv-link" href="/cv/">Ver CV completo · versión imprimible →</a>
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .job {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 32px;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }

  .job {
    scroll-margin-top: 32px;
  }

  /* Arriving from a timeline link: flash the entry with the highlighter */
  .job:target {
    animation: target-flash 1.6s ease-out;
  }

  @keyframes target-flash {
    from {
      background: var(--hl);
    }
    to {
      background: transparent;
    }
  }

  .job[hidden] {
    display: none;
  }

  .job__dates {
    font-size: 13px;
    line-height: 1.5;
  }

  .job__side {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Hueco de alto fijo: las fechas quedan a la misma altura en todas las filas */
  .job__logo {
    height: 34px;
    display: flex;
    align-items: center;
  }

  .job__dates {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .now {
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--on-yellow);
    font-size: 11px;
    font-weight: 500;
  }

  .job__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .job__title {
    font-size: 19px;
    font-weight: 600;
  }

  .job__title .muted {
    font-weight: 400;
  }

  .job__text {
    font-size: 15px;
    line-height: 1.6;
  }

  .job__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 15px;
    line-height: 1.5;
  }

  /* Highlighter tick: the brand yellow marks each achievement */
  .job__highlights li {
    position: relative;
    padding-left: 18px;
  }

  .job__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 3px;
    border-radius: 2px;
    background: var(--yellow);
  }

  .job__more {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
  }

  .job__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cv-link {
    align-self: flex-start;
    font-size: 14px;
  }

  @media (max-width: 640px) {
    .job {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .job__dates {
      flex-direction: row;
      align-items: center;
    }
    .job__side {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-filterable]')) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-tags]')];
    const status = root.querySelector<HTMLElement>('[data-filter-status]');

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter!;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        let shown = 0;
        for (const item of items) {
          const match = f === 'Todo' || item.dataset.tags!.split('|').includes(f);
          item.hidden = !match;
          if (match) shown++;
        }
        if (status) status.textContent = `${shown} resultados`;
      });
    }
  }
</script>
