---
import { experience, experienceFilters } from '../../data/career';
---

<section id="experiencia" class="section" aria-labelledby="experiencia-titulo" data-filterable>
  <h2 id="experiencia-titulo" class="eyebrow">04 — Experiencia</h2>

  <div class="filters" role="group" aria-label="Filtrar por enfoque">
    {
      experienceFilters.map((f, i) => (
        <button class="chip" type="button" aria-pressed={i === 0 ? "true" : "false"} data-filter={f}>
          {f}
        </button>
      ))
    }
  </div>

  <ol class="jobs">
    {
      experience.map((job) => (
        <li class="job" data-tags={job.filters.join('|')}>
          <p class="mono muted job__dates">{job.dates}</p>
          <div class="job__body">
            <h3 class="job__title">
              {job.role} <span class="muted">· {job.org}</span>
            </h3>
            <p class="muted job__text">{job.text}</p>
            <ul class="job__tags" aria-label="Tecnologías">
              {job.tags.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="sr-only" aria-live="polite" data-filter-status></p>

  <a class="mono cv-link" href="/cv/">Ver CV completo · versión imprimible →</a>
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .job {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 32px;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }

  .job[hidden] {
    display: none;
  }

  .job__dates {
    font-size: 13px;
    line-height: 1.5;
    padding-top: 4px;
  }

  .job__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .job__title {
    font-size: 19px;
    font-weight: 600;
  }

  .job__title .muted {
    font-weight: 400;
  }

  .job__text {
    font-size: 15px;
    line-height: 1.6;
  }

  .job__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cv-link {
    align-self: flex-start;
    font-size: 14px;
  }

  @media (max-width: 640px) {
    .job {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-filterable]')) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-tags]')];
    const status = root.querySelector<HTMLElement>('[data-filter-status]');

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter!;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        let shown = 0;
        for (const item of items) {
          const match = f === 'Todo' || item.dataset.tags!.split('|').includes(f);
          item.hidden = !match;
          if (match) shown++;
        }
        if (status) status.textContent = `${shown} resultados`;
      });
    }
  }
</script>
