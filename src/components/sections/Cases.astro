---
import Logo from '../Logo.astro';
import { caseMeta, type Project } from '../../lib/projects';
import { href } from '../../i18n';
import { getI18n } from '../../i18n/ui';

interface Props {
  cases: Project[];
  /** Show only the first N cases and a link to the cases page with all of them. */
  limit?: number;
  heading?: string;
  /** When set, adds a link to the full archive (the home page has no archive section). */
  projectsTotal?: number;
}

const { lang, ui } = getI18n(Astro.url);
const { cases, limit, heading = ui.cases, projectsTotal } = Astro.props;
const shownCases = limit ? cases.slice(0, limit) : cases;
---

<section id="casos" class="section" aria-labelledby="casos-titulo">
  <h2 id="casos-titulo" class="eyebrow">{heading}</h2>
  <ul class="cases">
    {
      shownCases.map((project) => (
        <li>
          <a class="card case logo-host" href={href(lang, { name: 'case', id: project.id })}>
            <div class="case__main">
              {project.data.logo && <Logo id={project.data.logo} scale={0.9} class="case__logo" />}
              <p class="mono muted case__meta">{caseMeta(project, lang)}</p>
              <h3 class="case__title">{project.data.title}</h3>
              <p class="muted case__summary">{project.data.summary}</p>
              <p class="mono muted case__stack">{project.data.stack.slice(0, 5).join(' · ')}</p>
            </div>
            {project.data.metric && (
              <div class="case__metric">
                <span class="case__value">
                  <span class="hl">{project.data.metric.value}</span>
                </span>
                <span class="mono muted case__label">{project.data.metric.label}</span>
              </div>
            )}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="more-links">
    {
      shownCases.length < cases.length && (
        <a class="more-link" href={href(lang, { name: 'cases' })}>
          {ui.seeAllCases(cases.length)} <span aria-hidden="true">→</span>
        </a>
      )
    }
    {
      projectsTotal && (
        <a class="more-link" href={href(lang, { name: 'archive' })}>
          {ui.exploreArchive(projectsTotal)} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .case {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    gap: 32px;
    padding: clamp(20px, 3vw, 30px);
  }

  .case__main {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .case__main :global(.case__logo) {
    align-self: flex-start;
    margin-bottom: 4px;
  }

  .more-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
  }


  .case__meta,
  .case__stack {
    font-size: 12px;
    line-height: 1.5;
  }

  .case__meta {
    text-transform: uppercase;
  }

  .case__title {
    font-size: clamp(21px, 2.4vw, 25px);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .case:hover .case__title {
    color: var(--mag);
  }

  .case__summary {
    font-size: 15px;
    line-height: 1.6;
  }

  .case__metric {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .case__value {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .case__label {
    font-size: 12px;
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .case {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .case__metric {
      padding: 16px 0 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
